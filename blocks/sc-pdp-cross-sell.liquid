{%- comment -%}
  Theme block entry point (Horizon and other themes whose sections accept @theme blocks).
  Settings mirror the "sc_pdp_cross_sell" block in sections/main-product.liquid – keep them in sync.
{%- endcomment -%}
{%- liquid
  assign sc_product = closest.product
  if sc_product == blank
    assign sc_product = product
  endif
-%}
{% render 'sc-pdp-cross-sell', block: block, product: sc_product %}

{% schema %}
{
  "name": "SC – Up-/Cross-selling",
  "settings": [
    {
      "type": "paragraph",
      "content": "Products come from the product metafield standard.cro_up_cross_selling (Product – List of products). If a product has none, the block can show Search & Discovery app recommendations (complementary, then related) and finally the fallback collection. The block hides itself when nothing is found."
    },
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Show up-/cross-selling",
      "default": true
