      "default": "1 x",
      "info": "eg. 1 x, 2 x 300g, 6x400g. Leave empty to hide this option."
    },
    {
      "type": "number",
      "id": "o1_quantity",
      "label": "Cart quantity",
      "default": 1
    },
    {
      "type": "text",
      "id": "o1_value",
