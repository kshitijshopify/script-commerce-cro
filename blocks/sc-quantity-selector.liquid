{%- comment -%}
  Theme block entry point (Horizon and other themes whose sections accept @theme blocks).
  Settings mirror the "sc_quantity_selector" block in sections/main-product.liquid – keep them in sync.
  Pass the product form id your theme uses; Horizon/Dawn style ids are detected in JS as a fallback.
{%- endcomment -%}
{%- liquid
  assign sc_product = closest.product
  if sc_product == blank
    assign sc_product = product
  endif
  assign sc_form_id = 'product-form-' | append: section.id
-%}
{% render 'sc-quantity-selector', block: block, product: sc_product, product_form_id: sc_form_id, section: section %}

{% schema %}
{
  "name": "SC – Quantity selector",
  "settings": [
    {
      "type": "paragraph",
      "content": "Pack sizes as buttons or cards. Discount badges are labels only – create a matching automatic discount in Shopify (Discounts) so the cart price follows."
    },
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "text",
          "label": "Text only"
        },
        {
          "value": "text_badge",
          "label": "Text + badge"
        },
        {
          "value": "visual",
          "label": "Visual (image cards)"
        }
      ],
      "default": "text_badge"
    },
    {
      "type": "select",
      "id": "mode",
      "label": "Selection sets",
      "options": [
        {
          "value": "quantity",
          "label": "Cart quantity"
        },
        {
          "value": "variant",
          "label": "Variant (option value)"
        }
      ],
      "default": "quantity",
      "info": "Cart quantity: the option quantity is added to the cart. Variant: selects the variant whose option value matches \"Variant option value\" – the theme variant picker must stay on the page."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose your quantity:"
    },
    {
      "type": "checkbox",
      "id": "show_selected",
      "label": "Show selected option in heading",
      "default": true
    },
    {
      "type": "range",
      "id": "default_option",
      "label": "Preselected option",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 1,
      "info": "In Variant mode the option matching the current variant is preselected."
    },
    {
      "type": "checkbox",
      "id": "hide_theme_quantity",
      "label": "Hide theme quantity selector",
      "default": true,
      "info": "Cart quantity mode only."
    },
    {
      "type": "checkbox",
      "id": "hide_theme_variant_picker",
      "label": "Hide theme variant picker",
      "default": false,
