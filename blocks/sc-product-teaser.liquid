{%- comment -%}
  Theme block entry point (Horizon and other themes whose sections accept @theme blocks).
  Settings mirror the "sc_product_teaser" block in sections/main-product.liquid – keep them in sync.
  Place it under the product title and above the price.
{%- endcomment -%}
{%- liquid
  assign sc_product = closest.product
  if sc_product == blank
    assign sc_product = product
  endif
-%}
{% render 'sc-product-teaser', product: sc_product, placement: 'product', block: block %}

{% schema %}
{
  "name": "SC – Product teaser",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Show on the product page",
      "default": true,
      "info": "Collection cards have their own switch in Theme settings → SC – Product teaser."
    },
    {
      "type": "paragraph",
      "content": "A short line under the title, from the product rich text metafield custom.cro_product_teaser. Nothing is shown when that metafield is empty."
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 14
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "rgba(0,0,0,0)",
      "info": "Transparent uses the surrounding text color."
    },
    {
      "type": "range",
      "id": "space_top",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Space above",
      "default": 6
    },
    {
      "type": "range",
      "id": "space_bottom",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Space below",
      "default": 8
    }
  ]
}
{% endschema %}
