{%- comment -%}
  Theme block entry point (Horizon and other themes whose sections accept @theme blocks).
  Settings mirror the "sc_pdp_variant_cards" block in sections/main-product.liquid – keep them in sync.
  Place it where the theme's variant picker sits (above the Add to Cart / buy buttons block).
{%- endcomment -%}
{%- liquid
  assign sc_product = closest.product
  if sc_product == blank
    assign sc_product = product
  endif
-%}
{% render 'sc-pdp-variant-cards', block: block, product: sc_product, section: section %}

{% schema %}
{
  "name": "SC – Variant cards",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Enable block",
      "default": true
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading",
      "default": "[option]: [value]",
      "info": "[option] = option name, [value] = selected variant. Leave empty to hide."
    },
    {
      "type": "header",
      "content": "Card content"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show variant price",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_unit_price",
      "label": "Show unit price",
      "default": true,
      "info": "Uses the variant's Shopify unit price, otherwise its shipping weight. If neither is set, the variant price is shown."
    },
    {
      "type": "select",
      "id": "mass_unit",
      "label": "Weight-based price per",
      "default": "kg",
      "options": [
        {
          "value": "kg",
          "label": "1 kg"
        },
        {
          "value": "100g",
          "label": "100 g"
        },
        {
          "value": "lb",
          "label": "1 lb"
        },
        {
          "value": "oz",
          "label": "1 oz"
        }
      ]
    },
    {
      "type": "header",
      "content": "Savings badge"
    },
    {
      "type": "text",
      "id": "savings_text",
      "label": "Badge text",
      "default": "Save [percent]%",
      "info": "Compared with the first variant's unit price. Leave empty to hide."
    },
    {
      "type": "color",
      "id": "savings_bg",
      "label": "Background",
      "default": "#4A4A4A"
    },
    {
      "type": "color",
      "id": "savings_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Popular variant label"
    },
    {
      "type": "text",
      "id": "popular_label",
      "label": "Label",
      "default": "Bestseller",
      "info": "Shown on variants whose 'Popular variant' metafield (custom.popular_variant) is true. Leave empty to hide."
    },
    {
      "type": "color",
      "id": "popular_bg",
      "label": "Background",
      "default": "#F5A623"
    },
    {
      "type": "color",
      "id": "popular_color",
      "label": "Text",
      "default": "#1A1A1A"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Cards per row (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "info": "Mobile shows one row you can swipe."
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Border",
      "default": "#D4D4D4"
    },
    {
      "type": "color",
      "id": "selected_border",
      "label": "Selected border",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "card_text",
      "label": "Title text",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "card_muted",
      "label": "Price text",
      "default": "#7A7A7A"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top spacing",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "SC – Variant cards"
    }
  ]
}
{% endschema %}
