{%- comment -%}
  Theme block entry point (Horizon and other themes whose sections accept @theme blocks).
  Settings mirror the "sc_store_benefits" block in sections/main-product.liquid – keep them in sync.
{%- endcomment -%}
{% render 'sc-store-benefits', block: block %}

{% schema %}
{
  "name": "SC – Store benefits",
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Show store benefits",
      "default": true
    },
    {
      "type": "select",
      "id": "display_style",
      "label": "Display style",
      "options": [
        {
          "value": "normal",
          "label": "Normal (grid)"
        },
        {
          "value": "list",
          "label": "List (one per row)"
        },
        {
          "value": "slider",
          "label": "Slider (tabs)"
        }
      ],
      "default": "normal"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Optional. Leave empty to hide."
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Normal style"
    },
    {
      "type": "select",
      "id": "item_layout",
      "label": "Benefit layout",
      "options": [
        {
          "value": "horizontal",
          "label": "Horizontal (icon beside text)"
        },
        {
          "value": "vertical",
          "label": "Vertical (icon above text)"
        }
      ],
      "default": "horizontal"
    },
    {
      "type": "select",
      "id": "icon_valign",
      "label": "Icon vertical alignment",
      "info": "Horizontal layout only. Use Top when text wraps onto several lines.",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "top",
          "label": "Top"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Benefits per row (desktop)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Benefits per row (mobile)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "show_description_normal",
      "label": "Show descriptions in normal style",
      "default": false
    },
    {
      "type": "header",
      "content": "List style"
    },
    {
      "type": "paragraph",
      "content": "Simple list: one benefit per row, icon beside the text, no box around each benefit. Use Block background and Block padding for the panel look."
    },
    {
      "type": "range",
      "id": "list_row_gap",
      "label": "Space between rows",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "list_icon_column",
      "label": "Icon column width",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Keeps text aligned when icons have different widths. 0 = automatic."
    },
    {
      "type": "checkbox",
      "id": "list_divider",
      "label": "Show divider lines between rows",
      "default": false
    },
    {
      "type": "color",
      "id": "list_divider_color",
      "label": "Divider color",
      "default": "rgba(0,0,0,0.12)"
    },
    {
      "type": "checkbox",
      "id": "list_show_description",
      "label": "Show descriptions",
      "default": false
    },
    {
      "type": "header",
      "content": "Slider style"
    },
    {
      "type": "checkbox",
      "id": "show_tab_labels",
      "label": "Show headline under each tab icon",
      "info": "Tabs without an icon always show their headline.",
      "default": false
    },
    {
      "type": "range",
      "id": "underline_thickness",
