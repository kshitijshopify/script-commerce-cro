{%- comment -%}
  Theme block entry point (Horizon and other themes whose sections accept @theme blocks).
  Settings mirror the "sc_social_proof_banner" block in sections/main-product.liquid – keep them in sync.
{%- endcomment -%}
{% render 'sc-social-proof-banner', block: block %}

{% schema %}
{
  "name": "SC – Social proof banner",
  "settings": [
    {
      "type": "select",
      "id": "banner_type",
      "label": "Banner type",
      "options": [
        {
          "value": "social",
          "label": "Social banner"
        },
        {
          "value": "rating",
          "label": "Rating banner"
        }
      ],
      "default": "social"
    },
    {
      "type": "header",
      "content": "Social banner"
    },
    {
      "type": "image_picker",
      "id": "avatar_1",
      "label": "Avatar 1"
    },
    {
      "type": "image_picker",
      "id": "avatar_2",
      "label": "Avatar 2"
    },
    {
      "type": "image_picker",
      "id": "avatar_3",
      "label": "Avatar 3"
    },
    {
      "type": "image_picker",
      "id": "avatar_4",
      "label": "Avatar 4"
    },
    {
      "type": "image_picker",
      "id": "avatar_5",
      "label": "Avatar 5",
      "info": "Empty slots are hidden automatically. Square images work best."
    },
    {
      "type": "text",
      "id": "name",
      "label": "Customer / influencer name",
      "default": "emma.style"
    },
    {
      "type": "checkbox",
      "id": "show_verified",
      "label": "Show verified checkmark",
      "default": true
    },
    {
      "type": "richtext",
      "id": "social_text",
      "label": "Social message",
      "default": "<p>and 63,000 others are thrilled with us</p>"
    },
    {
      "type": "checkbox",
      "id": "bold_text",
      "label": "Bold message text",
      "default": false
    },
    {
      "type": "select",
      "id": "avatar_shape",
      "label": "Avatar shape",
      "options": [
        {
          "value": "round",
          "label": "Round"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "round"
    },
    {
      "type": "range",
      "id": "avatar_size",
      "label": "Avatar size – desktop",
      "min": 20,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "avatar_size_mobile",
      "label": "Avatar size – mobile",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "avatar_overlap",
      "label": "Avatar overlap",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Rating banner"
    },
    {
      "type": "richtext",
      "id": "rating_text",
      "label": "Rating message",
      "default": "<p><strong>18,386+ customers</strong> rated us 5 stars (rating)</p>",
      "info": "Type (rating) where the five stars should appear."
    },
    {
      "type": "checkbox",
      "id": "append_stars",
      "label": "Add stars at the end if (rating) is missing",
      "default": true
    },
    {
      "type": "range",
      "id": "star_size",
      "label": "Star size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "text",
      "id": "stars_label",
      "label": "Stars screen reader label",
      "default": "Rated 5 out of 5 stars"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "corner_style",
      "label": "Corner style",
      "options": [
        {
          "value": "rounded",
          "label": "Rounded"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "rounded",
      "info": "Rounded rating banners always render as a pill."
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Social banner corner radius",
      "min": 2,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size – desktop",
      "min": 11,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font size – mobile",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F8F6F3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "name_color",
      "label": "Name",
      "info": "Leave empty to use the text color."
    },
    {
      "type": "color",
      "id": "check_color",
      "label": "Verified checkmark",
      "default": "#4C8AE7"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Stars",
      "default": "#FFC107"
    },
    {
      "type": "color",
      "id": "avatar_ring_color",
      "label": "Avatar ring",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show border",
      "default": false
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#E2DED8"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top margin",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom margin",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 4,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Horizontal padding",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "SC – Social proof banner"
    }
  ]
}
{% endschema %}
