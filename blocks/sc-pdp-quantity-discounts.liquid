{%- comment -%}
  Theme block entry point (Horizon and other themes whose sections accept @theme blocks).
  Settings mirror the "sc_pdp_quantity_discounts" block in sections/main-product.liquid – keep them in sync.
  Place it above the Add to Cart / buy buttons block.
{%- endcomment -%}
{%- liquid
  assign sc_product = closest.product
  if sc_product == blank
    assign sc_product = product
  endif
-%}
{% render 'sc-pdp-quantity-discounts', block: block, product: sc_product, section: section %}

{% schema %}
{
  "name": "SC – Quantity discounts",
  "settings": [
    {
      "type": "paragraph",
      "content": "This block only shows the discounted price. Create a matching automatic discount for each tier in Discounts (Amount off products, minimum quantity) – see the setup guide."
    },
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Enable block",
      "default": true
    },
    {
      "type": "text",
      "id": "only_tag",
      "label": "Only show on products tagged",
      "info": "Leave empty to show on every product."
    },
    {
      "type": "select",
      "id": "default_tier",
      "label": "Preselected tier",
      "options": [
        {
          "value": "badge",
          "label": "Tier with a badge"
        },
        {
          "value": "first",
          "label": "First tier"
        },
        {
          "value": "last",
          "label": "Last tier"
        }
      ],
      "default": "badge"
    },
    {
      "type": "checkbox",
      "id": "hide_theme_quantity",
      "label": "Hide the theme's quantity selector",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Buy more, save more"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Note below the tiers",
      "info": "E.g. \"Discount is applied at checkout.\""
    },
    {
      "type": "checkbox",
      "id": "show_original",
      "label": "Show original price struck through",
      "default": true
    },
    {
      "type": "header",
      "content": "Tier 1"
    },
    {
      "type": "checkbox",
      "id": "t1_enable",
      "label": "Show tier",
      "default": true
    },
    {
      "type": "number",
      "id": "t1_qty",
      "label": "Quantity",
      "default": 1
    },
    {
      "type": "number",
      "id": "t1_discount",
      "label": "Discount %",
      "default": 0
    },
    {
      "type": "text",
      "id": "t1_label",
      "label": "Label",
      "default": "1 unit",
      "info": "Use [qty], [percent], [price] or [savings]."
    },
    {
      "type": "text",
      "id": "t1_badge",
      "label": "Badge"
    },
    {
      "type": "header",
      "content": "Tier 2"
    },
    {
      "type": "checkbox",
      "id": "t2_enable",
      "label": "Show tier",
      "default": true
    },
    {
      "type": "number",
      "id": "t2_qty",
      "label": "Quantity",
      "default": 2
    },
    {
      "type": "number",
      "id": "t2_discount",
      "label": "Discount %",
      "default": 10
    },
    {
      "type": "text",
      "id": "t2_label",
      "label": "Label",
      "default": "2 units, save [percent]%"
    },
    {
      "type": "text",
      "id": "t2_badge",
      "label": "Badge",
      "default": "Popular"
    },
    {
      "type": "header",
      "content": "Tier 3"
    },
    {
      "type": "checkbox",
      "id": "t3_enable",
      "label": "Show tier",
      "default": true
    },
    {
      "type": "number",
      "id": "t3_qty",
      "label": "Quantity",
      "default": 3
    },
    {
      "type": "number",
      "id": "t3_discount",
      "label": "Discount %",
      "default": 15
    },
    {
      "type": "text",
      "id": "t3_label",
      "label": "Label",
      "default": "3+ units, save [percent]%"
    },
    {
      "type": "text",
      "id": "t3_badge",
      "label": "Badge"
    },
    {
      "type": "header",
      "content": "Tier 4"
    },
    {
      "type": "checkbox",
      "id": "t4_enable",
      "label": "Show tier",
      "default": false
    },
    {
      "type": "number",
      "id": "t4_qty",
      "label": "Quantity",
      "default": 5
    },
    {
      "type": "number",
      "id": "t4_discount",
      "label": "Discount %",
      "default": 20
