{%- comment -%}
  Theme block entry point (Horizon and other themes whose sections accept @theme blocks).
  Settings mirror the "sc_pdp_quantity_discounts" block in sections/main-product.liquid – keep them in sync.
  Place it above the Add to Cart / buy buttons block.
{%- endcomment -%}
{%- liquid
  assign sc_product = closest.product
  if sc_product == blank
    assign sc_product = product
  endif
-%}
{% render 'sc-pdp-quantity-discounts', block: block, product: sc_product, section: section %}

{% schema %}
