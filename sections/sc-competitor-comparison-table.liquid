    { "type": "text", "id": "sr_no", "label": "Screen-reader text: cross", "default": "No" },
    { "type": "text", "id": "sr_na", "label": "Screen-reader text: not applicable", "default": "Not applicable" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        { "type": "checkbox", "id": "enabled", "label": "Show this row", "default": true },
        { "type": "text", "id": "label", "label": "Feature label", "default": "Feature" },
