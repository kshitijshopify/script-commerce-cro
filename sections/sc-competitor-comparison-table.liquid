    { "type": "range", "id": "row_padding", "label": "Row height", "min": 8, "max": 32, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "row_gap", "label": "Space between rows", "min": 0, "max": 16, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "row_radius", "label": "Row corner radius", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 8 },
    { "type": "header", "content": "Brand highlight" },
    { "type": "color", "id": "highlight_color", "label": "Highlight colour", "default": "#5BE584" },
    { "type": "color", "id": "highlight_text_color", "label": "Brand name colour", "default": "#0E0E0E" },
    { "type": "color", "id": "brand_icon_color", "label": "Brand column icon colour", "default": "#0E0E0E" },
    { "type": "range", "id": "highlight_radius", "label": "Highlight corner radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "glow_size", "label": "Glow size", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 36, "info": "0 turns the glow off." },
    { "type": "range", "id": "glow_strength", "label": "Glow strength", "min": 5, "max": 100, "step": 5, "unit": "%", "default": 35 },
