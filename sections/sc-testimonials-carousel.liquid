{%- comment -%}
  SC – Testimonials carousel
  ScriptCommerce CRO section. Self-contained, theme-independent (Dawn, Horizon, any OS 2.0 theme).

  Horizontal carousel of testimonial cards (avatar, name + company, headline, star rating, review text).
  - Native horizontal scroll with scroll-snap: touch/swipe on mobile, trackpad, keyboard (track is focusable).
  - Prev/next arrows on desktop (hidden on touch-size screens), disabled at the ends.
  - Optional partial preview of the next card, progress indicator and autoplay.
  - Cards per view are set separately for desktop and mobile; tablet uses min(desktop, 2).
  - Controls hide automatically when every card already fits.
  - Empty testimonials are skipped on the storefront. The theme editor still shows them.
  - Each instance is scoped to its own root, so several sections on one page work independently.
{%- endcomment -%}
 
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign root = '#ScTc-' | append: sid

  assign heading = s.heading | strip
  assign subtitle = s.subtitle | strip
  assign has_header = false
  if heading != blank or subtitle != blank
    assign has_header = true
  endif

  assign bg = s.background_color | default: '#1F1F1F'
  assign heading_color = s.heading_color | default: '#FFFFFF'
  assign subtitle_color = s.subtitle_color | default: '#C4C4C4'
  assign card_bg = s.card_background | default: '#333333'
  assign card_border = s.card_border_color
  assign name_color = s.name_color | default: '#E6E6E6'
  assign headline_color = s.headline_color | default: '#FFFFFF'
  assign text_color = s.text_color | default: '#D9D9D9'
  assign star_color = s.star_color | default: '#3DD68C'
  assign star_empty = s.star_empty_color | default: '#5A5A5A'
  assign progress_color = s.progress_color | default: '#E5422B'
  assign progress_track = s.progress_track_color | default: '#3A3A3A'

  comment
    Count testimonials that will render, so the layout can drop the "peek" when every card fits.
  endcomment
  assign sc_total = 0
  for block in section.blocks
    if block.settings.enabled == false
      continue
    endif
    assign b_text = block.settings.text | strip_html | strip
    assign b_headline = block.settings.headline | strip
    assign b_name = block.settings.name | strip
    if b_text == blank and b_headline == blank and b_name == blank and request.design_mode == false
      continue
    endif
    assign sc_total = sc_total | plus: 1
  endfor

  assign n_d = s.cards_desktop | default: 3
  assign n_m = s.cards_mobile | default: 1
  assign n_t = n_d
  if n_t > 2
    assign n_t = 2
  endif

  assign peek_d = 0
  assign peek_t = 0
  assign peek_m = 0
  if s.show_peek
    if sc_total > n_d
      assign peek_d = 0.25
    endif
    if sc_total > n_t
      assign peek_t = 0.25
    endif
    if sc_total > n_m
      assign peek_m = 0.15
    endif
  endif

  assign gaps_d = n_d | minus: 1
  if peek_d > 0
    assign gaps_d = n_d
  endif
  assign gaps_t = n_t | minus: 1
  if peek_t > 0
    assign gaps_t = n_t
  endif
  assign gaps_m = n_m | minus: 1
  if peek_m > 0
    assign gaps_m = n_m
  endif

  assign heading_size_m = s.heading_size | times: 0.75 | round: 0
  if heading_size_m < 22
    assign heading_size_m = 22
  endif
  if heading_size_m > s.heading_size
    assign heading_size_m = s.heading_size
  endif
  assign text_size_m = s.text_size
  if text_size_m > 16
    assign text_size_m = 16
  endif
  assign card_pad_m = s.card_padding | times: 0.75 | round: 0
  if card_pad_m < 16
    assign card_pad_m = 16
  endif
  assign avatar_m = s.avatar_size | times: 0.85 | round: 0
  assign gap_m = s.card_gap
  if gap_m > 16
    assign gap_m = 16
  endif
  assign pad_top_m = s.padding_top | times: 0.75 | round: 0
  assign pad_bottom_m = s.padding_bottom | times: 0.75 | round: 0

  assign content_width = s.content_width | append: 'px'
  if s.full_width
    assign content_width = 'none'
  endif
-%}

{%- if s.enabled == false -%}
  {%- if request.design_mode -%}
    <div style="padding:16px;margin:8px auto;max-width:720px;border:1px dashed #b5b5b5;border-radius:8px;font:14px/1.4 sans-serif;color:#555;text-align:center;">
      SC – Testimonials carousel is hidden. Turn on “Show section” to display it.
    </div>
  {%- endif -%}
{%- else -%}
  <style>
    {{ root }} {
      --sc-tc-bg: {{ bg }};
      --sc-tc-heading: {{ heading_color }};
      --sc-tc-subtitle: {{ subtitle_color }};
      --sc-tc-card-bg: {{ card_bg }};
      --sc-tc-card-border: {% if card_border != blank %}{{ card_border }}{% else %}transparent{% endif %};
      --sc-tc-name: {{ name_color }};
      --sc-tc-headline: {{ headline_color }};
      --sc-tc-text: {{ text_color }};
      --sc-tc-star: {{ star_color }};
      --sc-tc-star-empty: {{ star_empty }};
      --sc-tc-progress: {{ progress_color }};
      --sc-tc-progress-track: {{ progress_track }};
      --sc-tc-width: {{ content_width }};
      --sc-tc-gutter: 16px;
      --sc-tc-radius: {{ s.card_radius }}px;
      --sc-tc-gap: {{ gap_m }}px;
      --sc-tc-pad: {{ card_pad_m }}px;
      --sc-tc-avatar: {{ avatar_m }}px;
      --sc-tc-heading-size: {{ heading_size_m }}px;
      --sc-tc-text-size: {{ text_size_m }}px;
      --sc-tc-pt: {{ pad_top_m }}px;
      --sc-tc-pb: {{ pad_bottom_m }}px;
      --sc-tc-n: {{ n_m }};
      --sc-tc-peek: {{ peek_m }};
      --sc-tc-gaps: {{ gaps_m }};

      display: block;
      background: var(--sc-tc-bg);
      color: var(--sc-tc-text);
      padding: var(--sc-tc-pt) 0 var(--sc-tc-pb);
      overflow: hidden;
    }
    @media screen and (min-width: 750px) {
      {{ root }} {
        --sc-tc-gutter: 32px;
        --sc-tc-gap: {{ s.card_gap }}px;
        --sc-tc-pad: {{ s.card_padding }}px;
        --sc-tc-avatar: {{ s.avatar_size }}px;
        --sc-tc-heading-size: {{ s.heading_size }}px;
        --sc-tc-text-size: {{ s.text_size }}px;
        --sc-tc-pt: {{ s.padding_top }}px;
        --sc-tc-pb: {{ s.padding_bottom }}px;
        --sc-tc-n: {{ n_t }};
        --sc-tc-peek: {{ peek_t }};
        --sc-tc-gaps: {{ gaps_t }};
      }
    }
    @media screen and (min-width: 990px) {
      {{ root }} {
        --sc-tc-gutter: 48px;
        --sc-tc-n: {{ n_d }};
        --sc-tc-peek: {{ peek_d }};
        --sc-tc-gaps: {{ gaps_d }};
      }
    }

    {{ root }} *,
    {{ root }} *::before,
    {{ root }} *::after {
      box-sizing: border-box;
    }
    {{ root }} .sc-tc__inner {
      max-width: var(--sc-tc-width);
      margin: 0 auto;
      padding: 0 var(--sc-tc-gutter);
    }

    {{ root }} .sc-tc__header {
      margin: 0 auto 32px;
      max-width: 760px;
      text-align: {{ s.heading_alignment }};
    }
    {% if s.heading_alignment == 'left' %}
      {{ root }} .sc-tc__header { margin-left: 0; }
    {% endif %}
    {{ root }} .sc-tc__heading {
      margin: 0;
      color: var(--sc-tc-heading);
      font-family: inherit;
      font-size: var(--sc-tc-heading-size);
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: -0.01em;
    }
    {{ root }} .sc-tc__subtitle {
      margin: 12px 0 0;
      color: var(--sc-tc-subtitle);
      font-size: calc(var(--sc-tc-text-size) + 1px);
      line-height: 1.55;
      opacity: 1;
    }
    {{ root }} .sc-tc__subtitle a {
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    /* Track: bleeds into the gutter so cards swipe edge to edge, but snaps to the content edge. */
    {{ root }} .sc-tc__track {
      position: relative;
      display: flex;
      align-items: {% if s.equal_height %}stretch{% else %}flex-start{% endif %};
      gap: var(--sc-tc-gap);
      margin: 0 calc(var(--sc-tc-gutter) * -1);
      padding: 4px var(--sc-tc-gutter) 8px;
      list-style: none;
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--sc-tc-gutter);
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    {{ root }} .sc-tc__track::-webkit-scrollbar {
      display: none;
    }
    {{ root }} .sc-tc__track:focus-visible {
      outline: 2px solid var(--sc-tc-progress);
      outline-offset: 2px;
    }
    {{ root }} .sc-tc__slide {
      display: flex;
      flex: 0 0 calc((100% - var(--sc-tc-gap) * var(--sc-tc-gaps)) / (var(--sc-tc-n) + var(--sc-tc-peek)));
      min-width: 0;
      margin: 0;
      padding: 0;
      scroll-snap-align: start;
    }

    {{ root }} .sc-tc__card {
      display: flex;
      flex-direction: column;
      width: 100%;
      padding: var(--sc-tc-pad);
      background: var(--sc-tc-card-bg);
      border: 1px solid var(--sc-tc-card-border);
      border-radius: var(--sc-tc-radius);
    }
    {{ root }} .sc-tc__author {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 20px;
      min-width: 0;
    }
    {{ root }} .sc-tc__avatar {
      flex: 0 0 auto;
      width: var(--sc-tc-avatar);
      height: var(--sc-tc-avatar);
      border-radius: 50%;
      overflow: hidden;
      background: rgba(255, 255, 255, 0.08);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--sc-tc-name);
      font-size: calc(var(--sc-tc-avatar) * 0.36);
      font-weight: 600;
      line-height: 1;
      text-transform: uppercase;
    }
    {{ root }} .sc-tc__avatar img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    {{ root }} .sc-tc__name {
      margin: 0;
      min-width: 0;
      color: var(--sc-tc-name);
      font-size: calc(var(--sc-tc-text-size) + 3px);
      font-weight: 400;
      line-height: 1.3;
      overflow-wrap: anywhere;
    }
    {{ root }} .sc-tc__company {
      white-space: nowrap;
    }
    {{ root }} .sc-tc__headline {
      margin: 0 0 10px;
      color: var(--sc-tc-headline);
      font-family: inherit;
      font-size: calc(var(--sc-tc-text-size) + 1px);
      font-weight: 700;
      line-height: 1.35;
    }
    {{ root }} .sc-tc__stars {
      display: flex;
      gap: 4px;
      margin: 0 0 12px;
      line-height: 0;
    }
    {{ root }} .sc-tc__star {
      width: 22px;
      height: 22px;
      fill: var(--sc-tc-star);
      flex: 0 0 auto;
    }
    {{ root }} .sc-tc__star--empty {
      fill: var(--sc-tc-star-empty);
    }
    {{ root }} .sc-tc__text {
      color: var(--sc-tc-text);
      font-size: var(--sc-tc-text-size);
      line-height: 1.65;
      {% if s.italic_text %}font-style: italic;{% endif %}
    }
    {{ root }} .sc-tc__text > :first-child { margin-top: 0; }
    {{ root }} .sc-tc__text > :last-child { margin-bottom: 0; }
    {{ root }} .sc-tc__text p { margin: 0 0 0.75em; }
    {{ root }} .sc-tc__text a { color: inherit; text-decoration: underline; }

    /* Controls */
    {{ root }} .sc-tc__controls {
      display: flex;
      align-items: center;
      gap: 20px;
      margin-top: 24px;
    }
    {{ root }} .sc-tc__progress {
      position: relative;
      flex: 1 1 auto;
      height: 3px;
      border-radius: 3px;
      background: var(--sc-tc-progress-track);
      overflow: hidden;
    }
    {{ root }} .sc-tc__progress-thumb {
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      width: 100%;
      border-radius: inherit;
      background: var(--sc-tc-progress);
      transition: left 0.15s linear, width 0.15s linear;
    }
    {{ root }} .sc-tc__arrows {
      display: none;
      gap: 10px;
      flex: 0 0 auto;
      margin-left: auto;
    }
    {{ root }} .sc-tc__arrow {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      margin: 0;
      padding: 0;
      border: 1px solid var(--sc-tc-card-border);
      border-radius: 50%;
      background: var(--sc-tc-card-bg);
      color: var(--sc-tc-headline);
      cursor: pointer;
      transition: opacity 0.2s ease, transform 0.2s ease;
      -webkit-appearance: none;
      appearance: none;
    }
    {{ root }} .sc-tc__arrow:hover:not(:disabled) {
      transform: scale(1.06);
    }
    {{ root }} .sc-tc__arrow:focus-visible {
      outline: 2px solid var(--sc-tc-progress);
      outline-offset: 2px;
    }
    {{ root }} .sc-tc__arrow:disabled {
      opacity: 0.35;
      cursor: default;
    }
    {{ root }} .sc-tc__arrow svg {
      width: 18px;
      height: 18px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    [dir='rtl'] {{ root }} .sc-tc__arrow svg {
      transform: scaleX(-1);
    }
    @media screen and (min-width: 990px) {
      {{ root }} .sc-tc__arrows { display: flex; }
    }
    {{ root }}.sc-tc--static .sc-tc__controls {
      display: none;
    }
    {{ root }} .sc-tc__empty {
      margin: 0;
      padding: 24px;
      border: 1px dashed var(--sc-tc-subtitle);
      border-radius: var(--sc-tc-radius);
      color: var(--sc-tc-subtitle);
      text-align: center;
      font-size: 14px;
    }
    @media (prefers-reduced-motion: reduce) {
      {{ root }} .sc-tc__progress-thumb,
      {{ root }} .sc-tc__arrow { transition: none; }
    }
  </style>

  <div
    id="ScTc-{{ sid }}"
    class="sc-tc"
    data-sc-tc
    data-sc-tc-autoplay="{% if s.autoplay %}{{ s.autoplay_speed }}{% else %}0{% endif %}"
    data-sc-tc-loop="{{ s.loop }}"
  >
    <div class="sc-tc__inner">
      {%- if has_header -%}
        <div class="sc-tc__header">
          {%- if heading != blank -%}
            <h2 class="sc-tc__heading">{{ heading | escape }}</h2>
          {%- endif -%}
          {%- if subtitle != blank -%}
            <p class="sc-tc__subtitle">{{ s.subtitle }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if sc_total > 0 -%}
        <ul
          class="sc-tc__track"
          id="ScTcTrack-{{ sid }}"
          data-sc-tc-track
          tabindex="0"
          role="region"
          aria-roledescription="carousel"
          aria-label="{{ heading | default: 'Customer testimonials' | escape }}"
        >
          {%- assign sc_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign b = block.settings
              if b.enabled == false
                continue
              endif
              assign name = b.name | strip
              assign company = b.company | strip
              assign headline = b.headline | strip
              assign text_plain = b.text | strip_html | strip
              if text_plain == blank and headline == blank and name == blank
                if request.design_mode == false
                  continue
                endif
                assign headline = 'Testimonial'
              endif
              assign sc_index = sc_index | plus: 1
              assign rating = b.rating | default: 0
              assign initials = ''
              if name != blank
                assign name_parts = name | split: ' '
                assign initials = name_parts.first | slice: 0
                if name_parts.size > 1
                  assign last_initial = name_parts.last | slice: 0
                  assign initials = initials | append: last_initial
                endif
              endif
            -%}
            <li
              class="sc-tc__slide"
              data-sc-tc-slide
              data-block-id="{{ block.id }}"
              role="group"
              aria-roledescription="slide"
              aria-label="{{ sc_index }} / {{ sc_total }}"
              {{ block.shopify_attributes }}
            >
              <article class="sc-tc__card">
                {%- if b.avatar != blank or name != blank or company != blank -%}
                  <div class="sc-tc__author">
                    {%- if b.avatar != blank -%}
                      {%- assign avatar_alt = b.avatar.alt | default: name -%}
                      <span class="sc-tc__avatar">
                        {{-
                          b.avatar
                          | image_url: width: 160
                          | image_tag:
                            loading: 'lazy',
                            width: s.avatar_size,
                            height: s.avatar_size,
                            alt: avatar_alt
                        -}}
                      </span>
                    {%- elsif initials != blank and s.show_initials -%}
                      <span class="sc-tc__avatar" aria-hidden="true">{{ initials | escape }}</span>
                    {%- endif -%}
                    {%- if name != blank or company != blank -%}
                      <p class="sc-tc__name">
                        {{- name | escape -}}
                        {%- if company != blank -%}
                          {%- if name != blank %} <span class="sc-tc__company">({{ company | escape }})</span>
                          {%- else -%}
                            <span class="sc-tc__company">{{ company | escape }}</span>
                          {%- endif -%}
                        {%- endif -%}
                      </p>
                    {%- endif -%}
                  </div>
                {%- endif -%}

                {%- if headline != blank -%}
                  <h3 class="sc-tc__headline">{{ headline | escape }}</h3>
                {%- endif -%}

                {%- if rating > 0 -%}
                  <div class="sc-tc__stars" role="img" aria-label="Rated {{ rating }} out of 5">
                    {%- for i in (1..5) -%}
                      <svg
                        class="sc-tc__star{% if i > rating %} sc-tc__star--empty{% endif %}"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                        focusable="false"
                      >
                        <path d="M12 2.5l2.94 6.06 6.66.92-4.85 4.66 1.18 6.62L12 17.6l-5.93 3.16 1.18-6.62L2.4 9.48l6.66-.92z"/>
                      </svg>
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                {%- if text_plain != blank -%}
                  <div class="sc-tc__text">{{ b.text }}</div>
                {%- endif -%}
              </article>
            </li>
          {%- endfor -%}
        </ul>

        {%- if s.show_progress or s.show_arrows -%}
          <div class="sc-tc__controls">
            {%- if s.show_progress -%}
              <div class="sc-tc__progress" aria-hidden="true">
                <span class="sc-tc__progress-thumb" data-sc-tc-thumb></span>
              </div>
            {%- endif -%}
            {%- if s.show_arrows -%}
              <div class="sc-tc__arrows">
                <button
                  type="button"
                  class="sc-tc__arrow"
                  data-sc-tc-prev
                  aria-controls="ScTcTrack-{{ sid }}"
                  aria-label="Previous testimonial"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 18l-6-6 6-6"/></svg>
                </button>
                <button
                  type="button"
                  class="sc-tc__arrow"
                  data-sc-tc-next
                  aria-controls="ScTcTrack-{{ sid }}"
                  aria-label="Next testimonial"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 18l6-6-6-6"/></svg>
                </button>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- elsif request.design_mode -%}
        <p class="sc-tc__empty">Add a Testimonial block, then enter a name, headline and review.</p>
      {%- endif -%}
    </div>
  </div>

  {%- if sc_total > 0 -%}
    <script>
      (function () {
        var api = window.__scTestimonials;
        if (!api) {
          var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

          var init = function (root) {
            if (!root || root.__scTc) return;
            var track = root.querySelector('[data-sc-tc-track]');
            if (!track) return;
            root.__scTc = true;

            var prev = root.querySelector('[data-sc-tc-prev]');
            var next = root.querySelector('[data-sc-tc-next]');
            var thumb = root.querySelector('[data-sc-tc-thumb]');
            var loop = root.getAttribute('data-sc-tc-loop') === 'true';
            var delay = (Number(root.getAttribute('data-sc-tc-autoplay')) || 0) * 1000;
            var rtl = getComputedStyle(track).direction === 'rtl';
            var ticking = false;
            var timer = null;
            var paused = false;
            var visible = true;

            var pos = function () { return Math.abs(track.scrollLeft); };
            var max = function () { return Math.max(0, track.scrollWidth - track.clientWidth); };

            var update = function () {
              ticking = false;
              var m = max();
              var p = pos();
              var scrollable = m > 2;
              root.classList.toggle('sc-tc--static', !scrollable);
              if (prev) prev.disabled = !scrollable || (!loop && p <= 2);
              if (next) next.disabled = !scrollable || (!loop && p >= m - 2);
              if (thumb) {
                var w = scrollable ? (track.clientWidth / track.scrollWidth) * 100 : 100;
                var ratio = scrollable ? Math.min(1, p / m) : 0;
                thumb.style.width = w + '%';
                thumb.style.left = rtl ? 'auto' : (100 - w) * ratio + '%';
                thumb.style.right = rtl ? (100 - w) * ratio + '%' : 'auto';
              }
            };
            var schedule = function () {
              if (ticking) return;
              ticking = true;
              window.requestAnimationFrame(update);
            };

            var stepSize = function () {
              var slide = track.querySelector('[data-sc-tc-slide]');
              if (!slide) return track.clientWidth;
              var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
              return slide.getBoundingClientRect().width + gap;
            };

            var go = function (dir) {
              var m = max();
              var p = pos();
              var behavior = reduced ? 'auto' : 'smooth';
              var sign = rtl ? -1 : 1;
              if (loop && dir > 0 && p >= m - 2) {
                track.scrollTo({ left: 0, behavior: behavior });
                return;
              }
              if (loop && dir < 0 && p <= 2) {
                track.scrollTo({ left: m * sign, behavior: behavior });
                return;
              }
              track.scrollBy({ left: dir * sign * stepSize(), behavior: behavior });
            };

            var stop = function () {
              if (timer) window.clearInterval(timer);
              timer = null;
            };
            var start = function () {
              stop();
              if (!delay || reduced || paused || !visible || max() <= 2) return;
              timer = window.setInterval(function () {
                if (!loop && pos() >= max() - 2) {
                  stop();
                  return;
                }
                go(1);
              }, delay);
            };
            var pause = function () { paused = true; stop(); };
            var resume = function () { paused = false; start(); };

            if (prev) prev.addEventListener('click', function () { go(-1); start(); });
            if (next) next.addEventListener('click', function () { go(1); start(); });

            track.addEventListener('scroll', schedule, { passive: true });
            track.addEventListener('keydown', function (e) {
              if (e.target !== track) return;
              if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
                e.preventDefault();
                var forward = e.key === 'ArrowRight' ? 1 : -1;
                go(rtl ? -forward : forward);
              }
            });

            if (delay) {
              root.addEventListener('mouseenter', pause);
              root.addEventListener('mouseleave', resume);
              root.addEventListener('focusin', pause);
              root.addEventListener('focusout', function (e) {
                if (!root.contains(e.relatedTarget)) resume();
              });
              track.addEventListener('touchstart', pause, { passive: true });
              if ('IntersectionObserver' in window) {
                new IntersectionObserver(function (entries) {
                  visible = entries[0] && entries[0].isIntersecting;
                  if (visible) start(); else stop();
                }, { threshold: 0.25 }).observe(root);
              }
            }

            if ('ResizeObserver' in window) {
              new ResizeObserver(function () { schedule(); start(); }).observe(track);
            } else {
              window.addEventListener('resize', schedule);
            }

            root.__scTcApi = {
              pause: pause,
              resume: resume,
              show: function (slide) {
                if (!slide || !track.contains(slide)) return;
                var pad = parseFloat(getComputedStyle(track).paddingLeft) || 0;
                var left = rtl
                  ? -(track.scrollWidth - slide.offsetLeft - slide.offsetWidth - pad)
                  : slide.offsetLeft - pad;
                track.scrollTo({ left: left, behavior: reduced ? 'auto' : 'smooth' });
              }
            };

            update();
            start();
          };

          var initAll = function (scope) {
            var roots = (scope || document).querySelectorAll('[data-sc-tc]');
            for (var i = 0; i < roots.length; i++) init(roots[i]);
          };

          document.addEventListener('shopify:section:load', function (e) { initAll(e.target); });
          document.addEventListener('shopify:block:select', function (e) {
            var slide = e.target && e.target.closest && e.target.closest('[data-sc-tc-slide]');
            var root = slide && slide.closest('[data-sc-tc]');
            if (!root || !root.__scTcApi) return;
            root.__scTcApi.pause();
            root.__scTcApi.show(slide);
          });
          document.addEventListener('shopify:block:deselect', function (e) {
            var root = e.target && e.target.closest && e.target.closest('[data-sc-tc]');
            if (root && root.__scTcApi) root.__scTcApi.resume();
          });

          api = window.__scTestimonials = { init: init, initAll: initAll };
        }
        api.init(document.getElementById('ScTc-{{ sid }}'));
      })();
    </script>
  {%- endif -%}
{%- endif -%}

