        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },

    { "type": "header", "content": "Download button" },
    { "type": "checkbox", "id": "show_download", "label": "Show download button", "default": false },
    { "type": "text", "id": "download_text", "label": "Button text", "default": "Download datasheet" },
    { "type": "url", "id": "download_link", "label": "Link", "info": "Paste a file URL from Content › Files (e.g. a PDF datasheet) or any page." },
    { "type": "checkbox", "id": "download_icon", "label": "Show download icon", "default": true },
    { "type": "checkbox", "id": "download_new_tab", "label": "Open in new tab", "default": true },
