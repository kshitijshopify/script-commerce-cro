    { "type": "range", "id": "price_size", "label": "Price size", "min": 12, "max": 30, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "spec_size", "label": "Specification size", "min": 11, "max": 20, "step": 1, "unit": "px", "default": 14 },
    { "type": "checkbox", "id": "accent_other_names", "label": "Accent colour on other product names", "default": true },
    { "type": "color", "id": "current_column_background", "label": "Current product column background" },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1A1A1A" },
    { "type": "color", "id": "secondary_text_color", "label": "Description and specification text", "default": "#4D4D4D" },
    { "type": "color", "id": "accent_color", "label": "Accent (current product, highlights)", "default": "#9A5A2E" },
    { "type": "color", "id": "divider_color", "label": "Divider lines", "default": "#CFCFCF" },
    { "type": "color", "id": "background", "label": "Section background", "default": "#EFEFEF" },
    { "type": "color", "id": "table_background", "label": "Table background" },
    { "type": "range", "id": "table_radius", "label": "Table corner radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "table_padding", "label": "Table padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "table_padding_mobile", "label": "Table padding (mobile)", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },

    { "type": "header", "content": "Width" },
    { "type": "checkbox", "id": "enable_custom_max_width", "label": "Custom max-width", "default": true },
    { "type": "range", "id": "custom_max_width", "label": "Max-width", "min": 400, "max": 2500, "step": 25, "unit": "px", "default": 1750 },

