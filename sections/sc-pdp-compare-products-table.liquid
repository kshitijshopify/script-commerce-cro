    { "type": "range", "id": "heading_size", "label": "Size", "min": 18, "max": 72, "step": 1, "unit": "px", "default": 40 },
    { "type": "range", "id": "heading_size_mobile", "label": "Size (mobile)", "min": 16, "max": 48, "step": 1, "unit": "px", "default": 28 },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
