        { "value": "metafield", "label": "Product metafield" }
      ],
      "default": "blocks",
      "info": "Metafield: uses the current product's \"sc_compare.products\" (list of products). Blocks are used when it is empty."
    },
    { "type": "checkbox", "id": "add_current", "label": "Metafield source: show current product first", "default": true },
    { "type": "checkbox", "id": "auto_detect_current", "label": "Highlight the product being viewed automatically", "default": true },
    { "type": "text", "id": "this_model_label", "label": "Current product label", "default": "This model" },
    { "type": "checkbox", "id": "link_products", "label": "Link images and names to products", "default": true },
    { "type": "checkbox", "id": "show_description", "label": "Show short description", "default": true },
