    { "type": "range", "id": "column_gap", "label": "Space between columns", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 12 },
    {
      "type": "select",
      "id": "table_alignment",
      "label": "Columns alignment",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" }
