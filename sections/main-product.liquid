    {
      "type": "sc_pdp_cross_sell",
      "name": "SC – Up-/Cross-selling",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Products come from the product metafield standard.cro_up_cross_selling (Product – List of products). If a product has none, the block can show Search & Discovery app recommendations (complementary, then related) and finally the fallback collection. The block hides itself when nothing is found."
        },
        {
          "type": "header",
          "content": "General"
        },
        {
          "type": "checkbox",
          "id": "enable",
          "label": "Show up-/cross-selling",
          "default": true
        },
        {
          "type": "inline_richtext",
          "id": "cro_up_cross_title",
          "label": "Heading",
          "default": "Buy it with"
        },
        {
          "type": "select",
          "id": "cro_up_cross_selling_layout",
          "label": "Layout",
          "options": [
            {
              "value": "slides",
              "label": "Slides (carousel)"
            },
            {
              "value": "stack",
              "label": "Stack (collapsible)"
            },
            {
              "value": "normal",
              "label": "Normal (always open list)"
            }
          ],
          "default": "slides"
        },
        {
          "type": "checkbox",
          "id": "cro_up_cross_open_stack",
          "label": "Open stack by default",
          "default": true,
          "visible_if": "{{ block.settings.cro_up_cross_selling_layout == 'stack' }}"
        },
        {
          "type": "select",
          "id": "reveal_mode",
          "label": "When to show",
          "options": [
            {
              "value": "always",
              "label": "Always"
            },
            {
              "value": "after_add",
              "label": "After main product is added to cart"
