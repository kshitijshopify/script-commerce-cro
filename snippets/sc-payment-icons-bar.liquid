{%- comment -%}
  SC – Payment icons bar (PDP, Cart, Cart drawer, Global)
  ----------------------------------------------------------------------------
  One shared implementation: Liquid + scoped CSS, no JavaScript, no theme deps.
  Settings live in Theme settings → "SC – Payment icons bar" (ids prefixed sc_pay_):
  - sc_pay_source: 'static'  → the methods ticked in sc_pay_m_* checkboxes
                   'dynamic' → shop.enabled_payment_types (active in Settings → Payments)
  - sc_pay_order:  comma-separated keys that set the icon order in both modes.

  Usage:
    PDP (Dawn product block):
      {% render 'sc-payment-icons-bar', placement: 'pdp', block: block %}
    Cart page / cart drawer (rendered only when the cart has items):
      {% render 'sc-payment-icons-bar', placement: 'cart', uid: 'cart-page' %}
      {% render 'sc-payment-icons-bar', placement: 'drawer', uid: 'cart-drawer' %}
    Anywhere else:
      {% render 'sc-payment-icons-bar', placement: 'global', uid: 'footer' %}

  Accepts:
  - placement: {String} 'pdp' | 'cart' | 'drawer' | 'global' (default 'global')
  - block:     {Object} block, for theme-editor attributes + unique id (optional)
  - uid:       {String} unique suffix when there is no block (optional)

  Notes:
  - Icons come from Shopify's native `payment_type_svg_tag` filter.
  - The SVG ids Shopify outputs (pi-visa …) are re-namespaced per instance,
    so several bars on one page never produce duplicate ids.
{%- endcomment -%}

{%- liquid
  assign placement = placement | default: 'global'

  assign sc_render = true
  if placement == 'cart' or placement == 'drawer'
    if cart.item_count == 0
      assign sc_render = false
    endif
  endif

  assign sc_uid = uid | default: placement
  if block.id != blank
    assign sc_uid = block.id
  endif
  assign sc_uid = sc_uid | handleize | prepend: 'sc-pay-bar-'
-%}

{%- if sc_render -%}
  {%- liquid
    # Known methods as payment_type key:checkbox setting id, in fallback order.
    assign methods = 'paypal:sc_pay_m_paypal,klarna:sc_pay_m_klarna,visa:sc_pay_m_visa,master:sc_pay_m_master,amazon:sc_pay_m_amazon,apple_pay:sc_pay_m_apple_pay,google_pay:sc_pay_m_google_pay,american_express:sc_pay_m_american_express,klarna-pay-later:sc_pay_m_klarna_pay_later,sofort:sc_pay_m_sofort,bitcoin:sc_pay_m_bitcoin,shopify_pay:sc_pay_m_shopify_pay,twint:sc_pay_m_twint' | split: ','

    # ---- 1. Candidate keys for the chosen source
    assign candidates = ','
    if settings.sc_pay_source == 'dynamic'
      for key in shop.enabled_payment_types
        assign candidates = candidates | append: key | append: ','
      endfor
    else
      for pair in methods
        assign parts = pair | split: ':'
        assign sid = parts[1]
        if settings[sid]
          assign candidates = candidates | append: parts[0] | append: ','
        endif
      endfor
    endif

    # ---- 2. Merchant order first (with friendly aliases), then the rest
    assign order_raw = settings.sc_pay_order | downcase | replace: ' ', '' | split: ','
    assign ordered = ','
    for name in order_raw
      case name
        when 'mastercard'
          assign key = 'master'
        when 'amex'
          assign key = 'american_express'
        when 'amazon_pay', 'amazonpay'
          assign key = 'amazon'
        when 'shop_pay', 'shoppay'
          assign key = 'shopify_pay'
        when 'applepay'
          assign key = 'apple_pay'
        when 'googlepay', 'gpay'
          assign key = 'google_pay'
        when 'klarna_pay_later'
          assign key = 'klarna-pay-later'
        else
          assign key = name
      endcase
      assign needle = ',' | append: key | append: ','
      if key != blank and candidates contains needle
        unless ordered contains needle
          assign ordered = ordered | append: key | append: ','
        endunless
      endif
    endfor

    assign rest = candidates | split: ','
    for key in rest
      assign needle = ',' | append: key | append: ','
      if key != blank
        unless ordered contains needle
          assign ordered = ordered | append: key | append: ','
        endunless
      endif
    endfor

    assign shown_keys = ordered | split: ','
  -%}

  {%- if shown_keys.size > 0 -%}
    <div
      id="{{ sc_uid }}"
      class="sc-pay-bar sc-pay-bar--{{ placement }}"
      {{ block.shopify_attributes }}
    >
      <ul class="sc-pay-bar__list" role="list" aria-label="Accepted payment methods">
        {%- assign svg_prefix = '"' | append: sc_uid | append: '-pi-' -%}
        {%- for key in shown_keys -%}
          <li class="sc-pay-bar__item">
            {{- key | payment_type_svg_tag: class: 'sc-pay-bar__svg' | replace: '"pi-', svg_prefix -}}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- elsif request.design_mode -%}
    <p class="sc-pay-bar__hint" {{ block.shopify_attributes }}>
      SC – Payment icons bar: no payment method to show. Tick methods (Static) or activate payment methods in Settings →
      Payments (Dynamic).
    </p>
  {%- endif -%}

  <style>
    .sc-pay-bar {
      box-sizing: border-box;
      width: 100%;
      margin: 12px 0;
      line-height: 0;
    }
    .sc-pay-bar__list {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .sc-pay-bar--drawer .sc-pay-bar__list,
    .sc-pay-bar--cart .sc-pay-bar__list {
      justify-content: space-between;
    }
    .sc-pay-bar__item {
      display: flex;
      flex: 0 0 auto;
      margin: 0;
      padding: 0;
    }
    .sc-pay-bar__svg {
      display: block;
      width: 44px;
      height: auto;
      aspect-ratio: 38 / 24;
    }
    .sc-pay-bar__hint {
      margin: 8px 0;
      padding: 8px 10px;
      font-size: 12px;
      font-style: italic;
      line-height: 1.4;
      opacity: 0.7;
      border: 1px dashed currentColor;
    }
    @media screen and (max-width: 749px) {
      .sc-pay-bar__list {
        gap: 6px;
      }
      .sc-pay-bar__svg {
        width: 38px;
      }
    }
  </style>
{%- endif -%}
