{%- comment -%}
  SC – Quantity discounts (PDP block)
  ----------------------------------------------------------------------------
  "Buy more, save more" tier selector for the buy box, e.g.
    ( ) 1 unit                      € 29.00
    (•) 2 units, save 10%  Popular  € 52.20
    ( ) 3+ units, save 15%          € 73.95

  Picking a tier sets the quantity of the theme's product form (or adds a hidden
  quantity field if the theme has none), so the theme's own Add to cart adds that
  many units. The block only SHOWS the discounted price – the real discount must
  come from a Shopify automatic discount (one per tier, "Amount off products" with
  a minimum quantity). See docs/sc-pdp-quantity-discounts-setup.md.

  Usage (inside any product section's block loop):
    {%- when 'sc_pdp_quantity_discounts' -%}
      {% render 'sc-pdp-quantity-discounts', block: block, product: product, section: section %}

  Accepts:
  - block:   {Object} block whose settings match the "sc_pdp_quantity_discounts" schema
             (sections/main-product.liquid or blocks/sc-pdp-quantity-discounts.liquid).
  - product: {Object} product (defaults to the global product).
  - section: {Object} parent section (used to scope the "hide theme quantity" CSS).

  Label placeholders: [qty] [percent] [price] [savings]

  Prices are rendered server-side for every variant with the `money` filter (active
  market currency) and swapped by JS when the variant changes.
  JS fires document event "sc:quantity-discounts:change" { productId, variantId, quantity, tier, discount }.
{%- endcomment -%}

{%- liquid
  assign s = block.settings
  assign uid = 'sc-qd-' | append: block.id
  assign p = product

  assign show_block = true
  if s.enable == false
    assign show_block = false
  endif
  assign tag_note = ''
  assign only_tag = s.only_tag | strip
  if p != blank and only_tag != blank
    unless p.tags contains only_tag
      assign show_block = false
      assign tag_note = 'this product does not have the tag "' | append: only_tag | append: '", so the block is hidden.'
    endunless
  endif
-%}

{%- if p == blank -%}
  {%- if request.design_mode and s.enable != false -%}
    <div {{ block.shopify_attributes }} style="padding:10px;font-size:13px;opacity:.6;font-style:italic;">
      SC – Quantity discounts: add this block to a product section to preview it.
    </div>
  {%- endif -%}
{%- elsif show_block == false -%}
  {%- if request.design_mode and tag_note != blank -%}
    <div {{ block.shopify_attributes }} style="padding:10px;font-size:13px;opacity:.6;font-style:italic;">
      SC – Quantity discounts: {{ tag_note | escape }}
    </div>
  {%- endif -%}
{%- else -%}
  {%- liquid
    # ---------- collect tiers: "qty fsep discount fsep label fsep badge fsep end" ----------
    assign fsep = '~§~'
    assign tsep = '~¶~'
    assign tiers_raw = ''
    for i in (1..4)
      assign k = 't' | append: i
      assign k_en = k | append: '_enable'
      assign k_q = k | append: '_qty'
      assign k_d = k | append: '_discount'
      assign k_l = k | append: '_label'
      assign k_b = k | append: '_badge'
      if s[k_en] == false
        continue
      endif
      assign tq = s[k_q] | plus: 0
      if tq < 1
        continue
      endif
      assign td = s[k_d] | default: 0 | times: 1.0
      assign tl = s[k_l] | append: '' | remove: fsep | remove: tsep
      assign tb = s[k_b] | append: '' | remove: fsep | remove: tsep
      assign tiers_raw = tiers_raw | append: tq | append: fsep | append: td | append: fsep | append: tl | append: fsep | append: tb | append: fsep | append: 'end' | append: tsep
    endfor
    assign tiers = tiers_raw | split: tsep
  -%}

  {%- if tiers.size == 0 -%}
    {%- if request.design_mode -%}
      <div {{ block.shopify_attributes }} style="padding:10px;font-size:13px;opacity:.6;font-style:italic;">
        SC – Quantity discounts: no tiers to show. Turn on at least one tier with a quantity of 1 or more.
      </div>
    {%- endif -%}
  {%- else -%}
    {%- liquid
      assign current = p.selected_or_first_available_variant

      # ---------- preselected tier ----------
      assign def_index = 0
      if s.default_tier == 'badge'
        for tier in tiers
          assign f = tier | split: fsep
          assign tb = f[3] | strip
          if tb != blank
            assign def_index = forloop.index0
            break
          endif
        endfor
      elsif s.default_tier == 'last'
        assign def_index = tiers.size | minus: 1
      endif

      assign atc_text = s.atc_text | strip | default: 'Add to cart' | escape
      assign heading = s.heading | strip | escape
      assign footer_text = s.footer_text | strip | escape
      assign has_badge = false
      assign tiers_html = ''
      assign current_tier_ok = true
    -%}

    {%- capture json_html -%}
      {
      {%- for v in p.variants -%}
        {%- liquid
          assign track_stock = false
          if v.inventory_management == 'shopify' and v.inventory_policy == 'deny'
            assign track_stock = true
          endif
          assign is_current = false
          if v.id == current.id
            assign is_current = true
          endif
        -%}
        "{{ v.id }}":{"a":{{ v.available | json }},"t":[
        {%- for tier in tiers -%}
          {%- liquid
            assign f = tier | split: fsep
            assign q = f[0] | plus: 0
            assign d = f[1] | times: 1.0 | at_least: 0 | at_most: 100
            assign keep = 100.0 | minus: d
            assign total = v.price | times: q | times: keep | divided_by: 100.0 | round
            assign original = v.price | times: q
            assign savings = original | minus: total | at_least: 0
            assign pct = 0
            if original > 0
              assign pct = savings | times: 100.0 | divided_by: original | round
            endif
            assign has_save = false
            if savings > 0
              assign has_save = true
            endif
            assign ok = v.available
            if track_stock and v.inventory_quantity < q
              assign ok = false
            endif
            assign m_total = total | money
            assign m_orig = original | money
            assign m_save = savings | money
          -%}
          {"p":{{ m_total | json }},"o":{{ m_orig | json }},"s":{{ m_save | json }},"r":{{ pct }},"z":{{ has_save }},"ok":{{ ok }}}
          {%- unless forloop.last -%},{%- endunless -%}

          {%- if is_current -%}
            {%- liquid
              assign tb = f[3] | strip | escape
              if tb != blank
                assign has_badge = true
              endif
              assign selected = false
              if forloop.index0 == def_index
                assign selected = true
                assign current_tier_ok = ok
              endif
              assign label_tpl = f[2] | strip
              if label_tpl == blank
                assign label_tpl = '[qty]'
              endif
              assign label_out = label_tpl | escape | replace: '[qty]', q | replace: '[percent]', pct | replace: '[price]', m_total | replace: '[savings]', m_save
            -%}
            {%- capture tier_html -%}
              <button
                type="button"
                role="radio"
                class="sc-qd__tier{% if selected %} is-selected{% endif %}{% if ok == false %} is-unavailable{% endif %}"
                aria-checked="{{ selected }}"
                {% if ok == false %}aria-disabled="true"{% endif %}
                tabindex="{% if selected %}0{% else %}-1{% endif %}"
                data-sc-qd-tier
                data-qty="{{ q }}"
              >
                {%- if tb != blank -%}
                  <span class="sc-qd__badge">{{ tb }}</span>
                {%- endif -%}
                <span class="sc-qd__radio" aria-hidden="true"></span>
                <span class="sc-qd__label" data-tpl="{{ label_tpl | escape }}">{{ label_out }}</span>
                <span class="sc-qd__prices">
                  {%- if s.show_original -%}
                    <s class="sc-qd__orig" data-f="o" data-needs-save{% unless has_save %} hidden{% endunless %}>{{ m_orig }}</s>
                  {%- endif -%}
                  <span class="sc-qd__price" data-f="p">{{ m_total }}</span>
                </span>
              </button>
            {%- endcapture -%}
            {%- assign tiers_html = tiers_html | append: tier_html -%}
          {%- endif -%}
        {%- endfor -%}
        ]}{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
      }
    {%- endcapture -%}

    <sc-qty-discounts
      id="{{ uid }}"
      class="sc-qd{% if has_badge %} sc-qd--has-badge{% endif %}{% if s.show_box %} sc-qd--box{% endif %}"
      data-product-id="{{ p.id }}"
      data-variant-id="{{ current.id }}"
      data-selected="{{ def_index }}"
      data-add-url="{{ routes.cart_add_url }}"
      data-cart-url="{{ routes.cart_url }}"
      {% if s.hide_theme_quantity %}data-hide-qty="true"{% endif %}
      style="
        --sc-qd-box-bg: {{ s.box_bg }};
        --sc-qd-box-border: {{ s.box_border }};
        --sc-qd-radius: {{ s.card_radius }}px;
        --sc-qd-bg: {{ s.card_bg }};
        --sc-qd-border: {{ s.card_border }};
        --sc-qd-text: {{ s.text_color }};
        --sc-qd-sel-bg: {{ s.selected_bg }};
        --sc-qd-sel-border: {{ s.selected_border }};
        --sc-qd-badge-bg: {{ s.badge_bg }};
        --sc-qd-badge-c: {{ s.badge_color }};
        --sc-qd-h-fs: {{ s.heading_size | default: 20 }}px;
        --sc-qd-label-fs: {{ s.label_size | default: 16 }}px;
        --sc-qd-atc-bg: {{ s.atc_bg }};
        --sc-qd-atc-c: {{ s.atc_color }};
        --sc-qd-mt: {{ s.margin_top }}px;
        --sc-qd-mb: {{ s.margin_bottom }}px;
      "
      {{ block.shopify_attributes }}
    >
      <div class="sc-qd__inner">
        {%- if heading != blank -%}
          <p class="sc-qd__heading" id="{{ uid }}-label">{{ heading }}</p>
        {%- endif -%}
        <div
          class="sc-qd__tiers"
          role="radiogroup"
          {% if heading != blank %}aria-labelledby="{{ uid }}-label"{% else %}aria-label="Quantity"{% endif %}
        >
          {{ tiers_html }}
        </div>

        {%- if s.show_atc -%}
          <button
            type="button"
            class="sc-qd__atc"
            data-sc-qd-atc
            data-text="{{ atc_text }}"
            data-sold-out="Sold out"
            {% unless current.available and current_tier_ok %}disabled{% endunless %}
          >
            {%- if current.available and current_tier_ok -%}{{ atc_text }}{%- else -%}Sold out{%- endif -%}
          </button>
          <p class="sc-qd__error" data-sc-qd-error role="alert" hidden></p>
        {%- endif -%}

        {%- if footer_text != blank -%}
          <p class="sc-qd__footer">{{ footer_text }}</p>
        {%- endif -%}
      </div>
      <script type="application/json" data-sc-qd-data>{{ json_html | strip_newlines }}</script>
    </sc-qty-discounts>

    <style>
      [data-sc-qd-hidden] { display: none !important; }
      {%- if s.hide_theme_quantity %}
      {%- comment -%} Pre-hide the theme quantity selector to avoid a flash; JS also hides whatever it detects. {%- endcomment -%}
      #shopify-section-{{ section.id }} :is(.product-form__quantity, quantity-selector-component):not(quick-add-modal *):not(dialog *) { display: none !important; }
      {%- endif %}

      #{{ uid }} {
        display: block;
        box-sizing: border-box;
        width: 100%;
        max-width: 100%;
        margin: var(--sc-qd-mt) 0 var(--sc-qd-mb);
        line-height: 1.35;
        letter-spacing: normal;
        text-transform: none;
        color: var(--sc-qd-text);
        --sc-qd-gap: 12px;
        --sc-qd-badge-fs: 13px;
        --sc-qd-badge-space: calc(var(--sc-qd-badge-fs) * 0.75 + 4px);
      }
      #{{ uid }} *,
      #{{ uid }} *::before,
      #{{ uid }} *::after { box-sizing: border-box; }
      #{{ uid }} [hidden] { display: none !important; }

      #{{ uid }}.sc-qd--box .sc-qd__inner {
        padding: 24px;
        background: var(--sc-qd-box-bg);
        border: 1px solid var(--sc-qd-box-border);
        border-radius: calc(var(--sc-qd-radius) + 2px);
      }

      #{{ uid }} .sc-qd__heading {
        margin: 0 0 14px;
        padding: 0;
        font-size: var(--sc-qd-h-fs);
        line-height: 1.3;
        font-weight: 400;
        color: var(--sc-qd-text);
        overflow-wrap: anywhere;
      }

      #{{ uid }} .sc-qd__tiers {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: var(--sc-qd-gap);
        margin: 0;
        padding: 0;
      }
      #{{ uid }}.sc-qd--has-badge .sc-qd__tiers {
        padding-top: var(--sc-qd-badge-space);
        row-gap: calc(var(--sc-qd-gap) + var(--sc-qd-badge-space));
      }

      #{{ uid }} .sc-qd__tier {
        -webkit-appearance: none;
        appearance: none;
        position: relative;
        display: flex;
        align-items: center;
        gap: 14px;
        width: 100%;
        min-width: 0;
        height: auto;
        min-height: 0;
        margin: 0;
        padding: 18px 24px;
        font: inherit;
        letter-spacing: normal;
        text-transform: none;
        text-decoration: none;
        text-align: left;
        color: var(--sc-qd-text);
        background: var(--sc-qd-bg);
        border: 1px solid var(--sc-qd-border);
        border-radius: var(--sc-qd-radius);
        box-shadow: none;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
        transition: border-color .15s ease, background-color .15s ease;
      }
      #{{ uid }} .sc-qd__tier::before { content: none; }
      /* Selected ring drawn on top of the card, no layout shift. */
      #{{ uid }} .sc-qd__tier::after {
        content: '';
        position: absolute;
        inset: -1px;
        border: 2px solid transparent;
        border-radius: var(--sc-qd-radius);
        pointer-events: none;
        transition: border-color .15s ease;
      }
      @media (hover: hover) {
        #{{ uid }} .sc-qd__tier:not(.is-unavailable):hover { border-color: var(--sc-qd-sel-border); }
      }
      #{{ uid }} .sc-qd__tier.is-selected { background: var(--sc-qd-sel-bg); }
      #{{ uid }} .sc-qd__tier.is-selected::after { border-color: var(--sc-qd-sel-border); }
      #{{ uid }} .sc-qd__tier:focus { outline: none; }
      #{{ uid }} .sc-qd__tier:focus-visible { outline: 2px solid var(--sc-qd-sel-border); outline-offset: 3px; }
      #{{ uid }} .sc-qd__tier.is-unavailable { cursor: not-allowed; }
      #{{ uid }} .sc-qd__tier.is-unavailable > :not(.sc-qd__badge) { opacity: .45; }

      #{{ uid }} .sc-qd__radio {
        position: relative;
        flex: 0 0 auto;
        width: 22px;
        height: 22px;
        border: 2px solid currentColor;
        border-radius: 50%;
        opacity: .55;
        transition: opacity .15s ease;
      }
      #{{ uid }} .sc-qd__radio::after {
        content: '';
        position: absolute;
        inset: 3px;
        border-radius: 50%;
        background: var(--sc-qd-sel-border);
        transform: scale(0);
        transition: transform .15s ease;
      }
      #{{ uid }} .sc-qd__tier.is-selected .sc-qd__radio { opacity: 1; border-color: var(--sc-qd-sel-border); }
      #{{ uid }} .sc-qd__tier.is-selected .sc-qd__radio::after { transform: scale(1); }

      #{{ uid }} .sc-qd__label {
        flex: 1 1 auto;
        min-width: 0;
        font-size: var(--sc-qd-label-fs);
        line-height: 1.3;
        overflow-wrap: anywhere;
      }

      #{{ uid }} .sc-qd__prices {
        flex: 0 0 auto;
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        align-items: baseline;
        gap: 2px 8px;
        max-width: 50%;
        text-align: right;
      }
      #{{ uid }} .sc-qd__price {
        font-size: var(--sc-qd-label-fs);
        font-weight: 500;
        line-height: 1.3;
        white-space: nowrap;
      }
      #{{ uid }} .sc-qd__orig {
        font-size: calc(var(--sc-qd-label-fs) * .85);
        line-height: 1.3;
        opacity: .6;
        white-space: nowrap;
      }

      #{{ uid }} .sc-qd__badge {
        position: absolute;
        top: 0;
        left: 50%;
        z-index: 2;
        max-width: calc(100% - 16px);
        padding: 3px 12px;
        font-size: var(--sc-qd-badge-fs);
        font-weight: 500;
        line-height: 1.3;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        color: var(--sc-qd-badge-c);
        background: var(--sc-qd-badge-bg);
        border-radius: 30px;
        transform: translate(-50%, -58%);
        pointer-events: none;
      }

      #{{ uid }} .sc-qd__atc {
        -webkit-appearance: none;
        appearance: none;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 48px;
        margin: 18px 0 0;
        padding: 8px 20px;
        font: inherit;
        font-size: var(--sc-qd-label-fs);
        font-weight: 500;
        line-height: 1.25;
        letter-spacing: normal;
        text-transform: none;
        color: var(--sc-qd-atc-c);
        background: var(--sc-qd-atc-bg);
        border: 0;
        border-radius: var(--sc-qd-radius);
        box-shadow: none;
        cursor: pointer;
        transition: opacity .15s ease;
      }
      @media (hover: hover) {
        #{{ uid }} .sc-qd__atc:not(:disabled):hover { opacity: .88; }
      }
      #{{ uid }} .sc-qd__atc:focus-visible { outline: 2px solid var(--sc-qd-atc-bg); outline-offset: 3px; }
      #{{ uid }} .sc-qd__atc:disabled { opacity: .5; cursor: not-allowed; }
      #{{ uid }} .sc-qd__atc.is-loading { opacity: .7; cursor: progress; }
      #{{ uid }} .sc-qd__error {
        margin: 8px 0 0;
        font-size: 13px;
        line-height: 1.4;
        color: #c62828;
      }
      #{{ uid }} .sc-qd__footer {
        margin: 12px 0 0;
        font-size: 13px;
        line-height: 1.4;
        opacity: .75;
      }

      @media screen and (max-width: 749px) {
        #{{ uid }} { --sc-qd-gap: 10px; }
        #{{ uid }}.sc-qd--box .sc-qd__inner { padding: 16px; }
        #{{ uid }} .sc-qd__heading { font-size: calc(var(--sc-qd-h-fs) * .9); }
        #{{ uid }} .sc-qd__label,
        #{{ uid }} .sc-qd__price { font-size: calc(var(--sc-qd-label-fs) * .94); }
        #{{ uid }} .sc-qd__tier { gap: 10px; padding: 16px 14px; }
        #{{ uid }} .sc-qd__radio { width: 20px; height: 20px; }
      }

      @media (prefers-reduced-motion: reduce) {
        #{{ uid }} .sc-qd__tier,
        #{{ uid }} .sc-qd__tier::after,
        #{{ uid }} .sc-qd__radio,
        #{{ uid }} .sc-qd__radio::after { transition: none; }
      }
    </style>

    <script>
      (function () {
        if (!window.customElements || window.customElements.get('sc-qty-discounts')) return;

        /* Common variant-change events across OS 2.0 themes (Dawn, Horizon, Focal, Impulse, Prestige ...) */
        var VARIANT_EVENTS = [
          'variant:change', 'variant:changed', 'variant:update', 'variantChange', 'variant-change',
          'on:variant:change', 'theme:variant:change', 'product:variant-change', 'product:variantChange',
          'shopify:variant:change'
        ];
        var EXCLUDE_CONTAINERS = 'quick-add-modal, dialog, [role="dialog"], cart-drawer';
        /* Wrappers themes put around their quantity selector. */
        var QTY_WRAPPERS = '.product-form__quantity, .product-form__input--quantity, quantity-selector-component, .product__quantity, .product-quantity, .quantity-selector, [data-quantity-selector]';
        var PLACEHOLDERS = /\[(qty|percent|price|savings)\]/g;

        /* Shared with other SC blocks: themes update ?variant= via replaceState, emit an event for it once. */
        if (!window.__scInvHistoryPatched && window.history) {
          window.__scInvHistoryPatched = true;
          ['pushState', 'replaceState'].forEach(function (fn) {
            var orig = window.history[fn];
            if (typeof orig !== 'function') return;
            window.history[fn] = function () {
              var result = orig.apply(this, arguments);
              try { window.dispatchEvent(new Event('sc:urlchange')); } catch (e) {}
              return result;
            };
          });
        }

        function toArray(list) { return Array.prototype.slice.call(list || []); }
        function fill(tpl, ctx) {
          return String(tpl || '').replace(PLACEHOLDERS, function (m, key) { return ctx[key] != null ? ctx[key] : ''; });
        }
        function idFromDetail(detail) {
          if (!detail || typeof detail !== 'object') return null;
          var v = detail.variant || detail.resource || detail.selectedVariant || detail.currentVariant || detail.newVariant;
          if (v && typeof v === 'object' && v.id) return String(v.id);
          if (detail.variantId) return String(detail.variantId);
          return null;
        }

        class ScQtyDiscounts extends HTMLElement {
          connectedCallback() {
            if (this._connected) return;
            this._connected = true;
            var dataEl = this.querySelector('[data-sc-qd-data]');
            try { this.data = JSON.parse(dataEl ? dataEl.textContent : '{}') || {}; } catch (e) { this.data = {}; }
            this.tiers = toArray(this.querySelectorAll('[data-sc-qd-tier]'));
            this.atc = this.querySelector('[data-sc-qd-atc]');
            this.errorEl = this.querySelector('[data-sc-qd-error]');
            this.variant = String(this.dataset.variantId || '');
            this.index = parseInt(this.dataset.selected, 10) || 0;
            this.qty = this.tierQty(this.index);
            this.scope = this.closest('[id^="shopify-section-"]') || this.closest('section, main') || document;

            this._onClick = this.onClick.bind(this);
            this._onKey = this.onKey.bind(this);
            this._onEvent = this.onVariantEvent.bind(this);
            this._onChange = this.onChange.bind(this);
            this._onSync = this.scheduleSync.bind(this);

            this.addEventListener('click', this._onClick);
            this.addEventListener('keydown', this._onKey);
            VARIANT_EVENTS.forEach(function (name) { document.addEventListener(name, this._onEvent); }, this);
            document.addEventListener('change', this._onChange, true);
            window.addEventListener('sc:urlchange', this._onSync);
            window.addEventListener('popstate', this._onSync);

            this.render();
            this.sync();
            /* The block usually sits above the buy buttons, so the product form may not be parsed yet. */
            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', this._onSync, { once: true });
            }
            this.scheduleSync();
          }

          disconnectedCallback() {
            this._connected = false;
            this.removeEventListener('click', this._onClick);
            this.removeEventListener('keydown', this._onKey);
            VARIANT_EVENTS.forEach(function (name) { document.removeEventListener(name, this._onEvent); }, this);
            document.removeEventListener('change', this._onChange, true);
            window.removeEventListener('sc:urlchange', this._onSync);
            window.removeEventListener('popstate', this._onSync);
            clearTimeout(this._t1); clearTimeout(this._t2);
          }

          tierQty(i) {
            var card = this.tiers[i];
            return card ? (parseInt(card.dataset.qty, 10) || 1) : 1;
          }

          tierData(i) {
            var vd = this.data[this.variant];
            return vd && vd.t ? vd.t[i] : null;
          }

          /* ---------- user interaction ---------- */

          onClick(event) {
            var t = event.target;
            if (!t || !t.closest) return;
            if (t.closest('[data-sc-qd-atc]')) { event.preventDefault(); this.addToCart(); return; }
            var card = t.closest('[data-sc-qd-tier]');
            if (!card || !this.contains(card)) return;
            event.preventDefault();
            this.select(this.tiers.indexOf(card), true);
          }

          onKey(event) {
            var card = event.target.closest && event.target.closest('[data-sc-qd-tier]');
            if (!card) return;
            var n = this.tiers.length;
            var i = this.tiers.indexOf(card);
            var dir = 0;
            switch (event.key) {
              case 'ArrowRight': case 'ArrowDown': dir = 1; break;
              case 'ArrowLeft': case 'ArrowUp': dir = -1; break;
              case 'Home': i = -1; dir = 1; break;
              case 'End': i = n; dir = -1; break;
              default: return;
            }
            event.preventDefault();
            for (var step = 0; step < n; step++) {
              i = (i + dir + n) % n;
              if (!this.tiers[i].classList.contains('is-unavailable')) break;
            }
            this.tiers[i].focus({ preventScroll: true });
            this.select(i, true);
          }

          select(i, fromUser) {
            var card = this.tiers[i];
            if (!card || card.classList.contains('is-unavailable')) return;
            this.index = i;
            this.qty = this.tierQty(i);
            this.paintSelection();
            this.applyQty();
            if (fromUser) {
              var t = this.tierData(i) || {};
              try {
                document.dispatchEvent(new CustomEvent('sc:quantity-discounts:change', {
                  detail: { productId: this.dataset.productId, variantId: this.variant, quantity: this.qty, tier: i + 1, discount: t.r || 0 }
                }));
              } catch (e) {}
            }
          }

          /* ---------- rendering ---------- */

          render() {
            var vd = this.data[this.variant];
            if (!vd) return;
            this.tiers.forEach(function (card, i) {
              var t = vd.t[i];
              if (!t) return;
              var c = { qty: this.tierQty(i), percent: t.r, price: t.p, savings: t.s };
              toArray(card.querySelectorAll('[data-tpl]')).forEach(function (el) { el.textContent = fill(el.getAttribute('data-tpl'), c); });
              toArray(card.querySelectorAll('[data-f]')).forEach(function (el) { el.textContent = t[el.getAttribute('data-f')] || ''; });
              toArray(card.querySelectorAll('[data-needs-save]')).forEach(function (el) { el.hidden = !t.z; });
              card.classList.toggle('is-unavailable', !t.ok);
              if (t.ok) card.removeAttribute('aria-disabled'); else card.setAttribute('aria-disabled', 'true');
            }, this);

            /* Selected tier not possible for this variant (stock): fall back to the biggest possible tier below it. */
            var cur = vd.t[this.index];
            if (vd.a && cur && !cur.ok) {
              var best = -1;
              var max = this.tierQty(this.index);
              this.tiers.forEach(function (card, i) {
                var t = vd.t[i];
                if (t && t.ok && this.tierQty(i) <= max && (best < 0 || this.tierQty(i) > this.tierQty(best))) best = i;
              }, this);
              if (best > -1) { this.index = best; this.qty = this.tierQty(best); this.applyQty(); }
            }
            this.paintSelection();
          }

          paintSelection() {
            var found = false;
            this.tiers.forEach(function (card, i) {
              var on = i === this.index;
              if (on) found = true;
              card.classList.toggle('is-selected', on);
              card.setAttribute('aria-checked', on ? 'true' : 'false');
              card.tabIndex = on ? 0 : -1;
            }, this);
            if (!found && this.tiers.length) this.tiers[0].tabIndex = 0;

            if (this.atc) {
              var vd = this.data[this.variant];
              var t = this.tierData(this.index);
              var ok = !!(vd && vd.a && (!t || t.ok));
              this.atc.disabled = !ok;
              this.atc.textContent = this.atc.getAttribute(ok ? 'data-text' : 'data-sold-out');
            }
          }

          /* ---------- product form / quantity ---------- */

          belongsToUs(node) {
            if (!node || !node.closest) return true;
            var form = node.closest('form') || node.form;
            var pid = form && form.querySelector('[name="product-id"]');
            return !pid || !pid.value || pid.value === this.dataset.productId;
          }

          productForms() {
            var self = this;
            return toArray(document.querySelectorAll('form[action*="/cart/add"]')).filter(function (form) {
              if (form.closest(EXCLUDE_CONTAINERS)) return false;
              if (/installment/i.test(form.id || '')) return false;
              var pid = form.querySelector('[name="product-id"]');
              if (pid && pid.value) return pid.value === self.dataset.productId;
              return self.scope !== document && self.scope.contains(form);
            });
          }

          /* Theme quantity inputs of our product form(s); adds a hidden one where a form has none. */
          qtyFields(create) {
            var fields = [];
            this.productForms().forEach(function (form) {
              var f = form.elements ? form.elements.namedItem('quantity') : null;
              var list = !f ? [] : (f.tagName ? [f] : toArray(f));
              list = list.filter(function (el) { return !(el.closest && el.closest(EXCLUDE_CONTAINERS)); });
              if (!list.length && create) {
                var hidden = document.createElement('input');
                hidden.type = 'hidden';
                hidden.name = 'quantity';
                hidden.setAttribute('data-sc-qd-qty', '');
                form.appendChild(hidden);
                list = [hidden];
              }
              fields = fields.concat(list);
            });
            return fields;
          }

          applyQty() {
            var value = String(this.qty);
            this._setting = true;
            try {
              this.qtyFields(true).forEach(function (f) {
                if (String(f.value) === value) return;
                f.value = value;
                if (f.hasAttribute('data-sc-qd-qty')) return;
                f.dispatchEvent(new Event('input', { bubbles: true }));
                f.dispatchEvent(new Event('change', { bubbles: true }));
              });
            } finally {
              this._setting = false;
            }
          }

          hideQty() {
            if (this.dataset.hideQty !== 'true') return;
            var self = this;
            this.qtyFields(false).forEach(function (f) {
              if (f.hasAttribute('data-sc-qd-qty')) return;
              var w = f.closest(QTY_WRAPPERS) || f.closest('quantity-input, quantity-selector');
              if (!w || w.contains(self) || self.contains(w)) return;
              if (!w.hasAttribute('data-sc-qd-hidden')) w.setAttribute('data-sc-qd-hidden', '');
            });
          }

          /* User changed the theme's quantity (if still visible): highlight the matching tier. */
          onUserQty(value) {
            var n = parseInt(value, 10);
            if (!n || n < 1) return;
            this.qty = n;
            var vd = this.data[this.variant];
            var best = -1;
            this.tiers.forEach(function (card, i) {
              var t = vd && vd.t[i];
              var q = this.tierQty(i);
              if ((!t || t.ok) && q <= n && (best < 0 || q > this.tierQty(best))) best = i;
            }, this);
            this.index = best;
            this.paintSelection();
          }

          readVariantId() {
            var forms = this.productForms();
            for (var i = 0; i < forms.length; i++) {
              var field = forms[i].elements ? forms[i].elements.namedItem('id') : null;
              if (field && !field.tagName && field.length) field = field[0];
              if (field && field.value) return String(field.value);
            }
            try {
              var fromUrl = new URL(window.location.href).searchParams.get('variant');
              if (fromUrl) return fromUrl;
            } catch (e) {}
            return null;
          }

          /* ---------- keeping in sync ---------- */

          onVariantEvent(event) {
            if (event.target && event.target !== document && event.target.closest && !this.belongsToUs(event.target)) return;
            var id = idFromDetail(event.detail);
            if (id) this.setVariant(id);
            this.scheduleSync();
          }

          onChange(event) {
            var t = event.target;
            if (this._setting || !t || this.contains(t) || !this.belongsToUs(t)) return;
            if (t.closest && t.closest(EXCLUDE_CONTAINERS)) return;
            if (t.name === 'quantity') { this.onUserQty(t.value); return; }
            if (t.name === 'id' && t.form && t.form.matches('form[action*="/cart/add"]')) this.setVariant(t.value);
            this.scheduleSync();
          }

          scheduleSync() {
            var self = this;
            clearTimeout(this._t1); clearTimeout(this._t2);
            this._t1 = setTimeout(function () { self.sync(); }, 80);
            this._t2 = setTimeout(function () { self.sync(); }, 600);
          }

          /* Themes often re-render the product form on variant change: re-read the variant, re-hide, re-apply the quantity. */
          sync() {
            this.hideQty();
            var id = this.readVariantId();
            if (id) this.setVariant(id);
            this.applyQty();
          }

          setVariant(id) {
            id = String(id || '');
            if (!id || id === this.variant || !this.data[id]) return;
            this.variant = id;
            this.render();
          }

          /* ---------- own Add to cart button ---------- */

          addToCart() {
            if (!this.atc || this.atc.disabled) return;
            this.showError('');
            this.applyQty();
            var btn = null;
            this.productForms().some(function (form) {
              var b = form.querySelector('button[type="submit"], input[type="submit"]') ||
                (form.id ? document.querySelector('button[type="submit"][form="' + form.id + '"]') : null);
              if (b && !b.disabled) { btn = b; return true; }
              return false;
            });
            if (btn) { btn.click(); return; }

            /* No usable theme form/button: add via the Ajax API, then open the cart. */
            var self = this;
            this.atc.classList.add('is-loading');
            fetch((this.dataset.addUrl || '/cart/add') + '.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
              body: JSON.stringify({ items: [{ id: Number(this.variant), quantity: this.qty }] })
            })
              .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
              .then(function (res) {
                if (!res.ok) throw new Error((res.j && (res.j.description || res.j.message)) || 'Could not add to cart.');
                window.location.href = self.dataset.cartUrl || '/cart';
              })
              .catch(function (e) { self.showError(e.message); })
              .then(function () { self.atc.classList.remove('is-loading'); });
          }

          showError(msg) {
            if (!this.errorEl) return;
            this.errorEl.textContent = msg || '';
            this.errorEl.hidden = !msg;
          }
        }

        window.customElements.define('sc-qty-discounts', ScQtyDiscounts);
      })();
    </script>
  {%- endif -%}
{%- endif -%}
