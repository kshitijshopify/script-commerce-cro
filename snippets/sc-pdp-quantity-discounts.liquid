          setVariant(id) {
            id = String(id || '');
            if (!id || id === this.variant || !this.data[id]) return;
            this.variant = id;
            this.render();
          }

          /* ---------- own Add to cart button ---------- */

          addToCart() {
            if (!this.atc || this.atc.disabled) return;
            this.showError('');
            this.applyQty();
            var btn = null;
            this.productForms().some(function (form) {
              var b = form.querySelector('button[type="submit"], input[type="submit"]') ||
                (form.id ? document.querySelector('button[type="submit"][form="' + form.id + '"]') : null);
              if (b && !b.disabled) { btn = b; return true; }
              return false;
            });
            if (btn) { btn.click(); return; }

            /* No usable theme form/button: add via the Ajax API, then open the cart. */
            var self = this;
            this.atc.classList.add('is-loading');
            fetch((this.dataset.addUrl || '/cart/add') + '.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
              body: JSON.stringify({ items: [{ id: Number(this.variant), quantity: this.qty }] })
            })
              .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
              .then(function (res) {
                if (!res.ok) throw new Error((res.j && (res.j.description || res.j.message)) || 'Could not add to cart.');
                window.location.href = self.dataset.cartUrl || '/cart';
              })
              .catch(function (e) { self.showError(e.message); })
              .then(function () { self.atc.classList.remove('is-loading'); });
          }

          showError(msg) {
            if (!this.errorEl) return;
            this.errorEl.textContent = msg || '';
            this.errorEl.hidden = !msg;
          }
        }

        window.customElements.define('sc-qty-discounts', ScQtyDiscounts);
      })();
    </script>
  {%- endif -%}
{%- endif -%}
