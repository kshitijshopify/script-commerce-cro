         instances Dawn creates each time it re-renders the cart HTML). */
      var G = (window.__scFreeGift = window.__scFreeGift || {
        busy: false,
        addFailed: {},
        actions: [],
        notice: null
      });
      /* addFailed is tracked per gift tier ('1' / '2'). */
      if (!G.addFailed || typeof G.addFailed !== 'object') G.addFailed = {};

      /* Loop guard: count automatic gift changes made with no customer cart
         change in between. Any customer / theme change resets the count. */
      document.addEventListener('sc:cart:changed', function () { G.actions = []; });

      /* ---------------------------------------------------------------
       * 2. Helpers
       * ------------------------------------------------------------- */
      var SVG_NS = 'http://www.w3.org/2000/svg';
      var SVG_TAGS = ['svg', 'g', 'path', 'circle', 'ellipse', 'rect', 'line', 'polyline', 'polygon', 'defs', 'lineargradient', 'radialgradient', 'stop', 'clippath', 'mask', 'symbol'];
      var SVG_ATTRS = /^(viewbox|d|fill|fill-rule|fill-opacity|clip-rule|stroke|stroke-width|stroke-linecap|stroke-linejoin|stroke-miterlimit|stroke-dasharray|stroke-dashoffset|stroke-opacity|opacity|transform|cx|cy|r|rx|ry|x|y|x1|x2|y1|y2|width|height|points|offset|stop-color|stop-opacity|gradientunits|gradienttransform|id|clip-path|mask|preserveaspectratio)$/i;

      /* Rebuilds a merchant SVG from an allow-list of shape elements and
         presentation attributes. Scripts, event handlers, links, styles,
         foreignObject and external url() references are all dropped. */
      function sanitizeSvg(source) {
        if (!source || typeof DOMParser === 'undefined') return null;
        var doc;
        try { doc = new DOMParser().parseFromString(String(source).trim(), 'image/svg+xml'); } catch (e) { return null; }
        if (!doc || doc.getElementsByTagName('parsererror').length) return null;
        var root = doc.documentElement;
        if (!root || root.nodeName.toLowerCase() !== 'svg') return null;
        function copy(node) {
          var name = node.nodeName.toLowerCase();
          if (SVG_TAGS.indexOf(name) === -1) return null;
          var el = document.createElementNS(SVG_NS, node.nodeName);
          for (var i = 0; i < node.attributes.length; i++) {
            var a = node.attributes[i];
            if (!SVG_ATTRS.test(a.name)) continue;
            var v = a.value;
            if (/javascript:|data:|expression\(/i.test(v)) continue;
            if (/url\(\s*['"]?\s*[^#\s'"]/i.test(v)) continue;
            el.setAttribute(a.name, v);
          }
          for (var c = 0; c < node.childNodes.length; c++) {
            if (node.childNodes[c].nodeType !== 1) continue;
            var child = copy(node.childNodes[c]);
            if (child) el.appendChild(child);
          }
          return el;
        }
        var svg = copy(root);
        if (!svg) return null;
        var w = parseFloat(svg.getAttribute('width'));
        var h = parseFloat(svg.getAttribute('height'));
        if (!svg.getAttribute('viewBox') && w > 0 && h > 0) svg.setAttribute('viewBox', '0 0 ' + w + ' ' + h);
        svg.removeAttribute('width');
        svg.removeAttribute('height');
        if (!svg.getAttribute('fill')) svg.setAttribute('fill', 'currentColor');
        svg.setAttribute('aria-hidden', 'true');
        svg.setAttribute('focusable', 'false');
        return svg;
      }

      function formatWithShopifyFormat(cents, format) {
        var placeholder = /\{\{\s*(\w+)\s*\}\}/;
        var match = format.match(placeholder);
        if (!match) return null;
        function delimit(number, precision, thousands, decimal) {
          var parts = (number / 100).toFixed(precision).split('.');
          var whole = parts[0].replace(/(\d)(?=(\d{3})+(?!\d))/g, '$1' + thousands);
          return parts[1] ? whole + decimal + parts[1] : whole;
        }
        var value;
        switch (match[1]) {
          case 'amount_no_decimals': value = delimit(cents, 0, ',', '.'); break;
          case 'amount_with_comma_separator': value = delimit(cents, 2, '.', ','); break;
          case 'amount_no_decimals_with_comma_separator': value = delimit(cents, 0, '.', ','); break;
          case 'amount_with_apostrophe_separator': value = delimit(cents, 2, "'", '.'); break;
          case 'amount_no_decimals_with_space_separator': value = delimit(cents, 0, ' ', ','); break;
          case 'amount_with_space_separator': value = delimit(cents, 2, ' ', ','); break;
          case 'amount_with_period_and_space_separator': value = delimit(cents, 2, ' ', '.'); break;
          default: value = delimit(cents, 2, ',', '.');
        }
        return format.replace(placeholder, value);
      }

      function sessionGet(key) { try { return window.sessionStorage.getItem(key); } catch (e) { return null; } }
      function sessionSet(key, val) { try { window.sessionStorage.setItem(key, val); } catch (e) {} }
      function sessionDel(key) { try { window.sessionStorage.removeItem(key); } catch (e) {} }

      var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
      if (root.slice(-1) !== '/') root += '/';

      function request(path, body) {
        var opts = {
          method: body ? 'POST' : 'GET',
          credentials: 'same-origin',
          headers: { Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'X-SC-Internal': '1' }
        };
        if (body) {
          opts.headers['Content-Type'] = 'application/json';
          opts.body = JSON.stringify(body);
        }
        return fetch(root + path, opts).then(function (res) {
          return res.json().then(function (data) {
            if (!res.ok) {
              var err = new Error((data && (data.description || data.message)) || 'Cart request failed');
              err.status = res.status;
              throw err;
            }
            return data;
          });
        });
      }

      function fetchSections(ids) {
        var batches = [];
        for (var i = 0; i < ids.length; i += 5) batches.push(ids.slice(i, i + 5));
        return Promise.all(batches.map(function (batch) {
          /* The comma must stay a literal comma: an encoded list (%2C) is not split into sections. */
          var url = root + 'cart?sections=' + batch.map(encodeURIComponent).join(',') + '&_sc=' + Date.now();
          return fetch(url, {
            credentials: 'same-origin',
            cache: 'no-store',
            headers: { Accept: 'application/json', 'X-SC-Internal': '1' }
          }).then(function (r) {
            if (!r.ok) throw new Error('Section render failed');
            return r.json();
          });
        })).then(function (results) {
          return Object.assign.apply(Object, [{}].concat(results));
        });
      }

      function parse(html) { return new DOMParser().parseFromString(html, 'text/html'); }

      /* Theme cart UI to re-render after the gift was added / removed.
         Dawn: cart drawer (.drawer__inner), cart page sections, header bubble.
         Other themes: cart sections inside <main>. Returns { ids, jobs };
         a job takes (sections, cart) and returns false when its section is missing. */
      function themeTargets() {
        var jobs = [];
        var ids = [];

        /* Dawn cart drawer */
        var drawerInner = document.querySelector('#CartDrawer .drawer__inner');
        if (drawerInner) {
          ids.push('cart-drawer');
          jobs.push(function (sections, cart) {
            if (!sections['cart-drawer']) return false;
            var fresh = parse(sections['cart-drawer']).querySelector('.drawer__inner');
            if (!fresh) return false;
            drawerInner.innerHTML = fresh.innerHTML;
            var empty = cart.item_count === 0;
            document.querySelectorAll('cart-drawer').forEach(function (d) { d.classList.toggle('is-empty', empty); });
          });
        }

        /* Header cart icon / count */
        var bubble = document.getElementById('cart-icon-bubble');
        if (bubble) {
          ids.push('cart-icon-bubble');
          jobs.push(function (sections) {
            if (!sections['cart-icon-bubble']) return false;
            var doc = parse(sections['cart-icon-bubble']);
            var fresh = doc.querySelector('.shopify-section') || doc.body;
            bubble.innerHTML = fresh.innerHTML;
          });
        }

        /* Cart page sections (Dawn: main-cart-items + main-cart-footer) */
        var onCartPage = /\/cart\/?$/.test(window.location.pathname);
        var scope = document.querySelector('main') || document.body;
        var pageSections = !onCartPage ? [] : Array.prototype.filter.call(scope.querySelectorAll('[id^="shopify-section-"]'), function (el) {
          var id = el.id.slice(16);
          return /cart/i.test(id) || !!el.querySelector('[name^="updates"], [name="checkout"]');
        });
        pageSections.forEach(function (el) {
          var id = el.id.slice(16);
          ids.push(id);
          jobs.push(function (sections) {
            if (!sections[id]) return false;
            var doc = parse(sections[id]);
            var fresh = doc.getElementById(el.id);
            el.innerHTML = fresh ? fresh.innerHTML : doc.body.innerHTML;
          });
        });

        return { ids: ids, jobs: jobs };
      }

      /* Body fields that make /cart/add.js and /cart/update.js return the
         re-rendered theme sections in the same response, so the cart HTML
         always matches the cart (as Dawn does). Shopify renders at most 5. */
      function sectionParams() {
        var ids = themeTargets().ids;
        if (!ids.length || ids.length > 5) return {};
        return { sections: ids.join(','), sections_url: window.location.pathname };
      }

      /* Re-render the theme's cart UI after the gift was added / removed.
         `sections`: rendered sections returned by the add / update request, if any. */
      function refreshThemeCart(cart, mode, sections) {
        document.dispatchEvent(new CustomEvent('sc:free-gift:updated', { detail: { cart: cart } }));
        if (mode === 'reload') { window.location.reload(); return Promise.resolve(); }

        try {
          document.dispatchEvent(new CustomEvent('cart:update', {
            bubbles: true,
            detail: { resource: cart, sourceId: 'sc-free-gift', data: { source: 'sc-free-gift', itemCount: cart.item_count } }
          }));
        } catch (e) {}

        var targets = themeTargets();
        if (!targets.ids.length) return Promise.resolve();

        var apply = function (data) {
          var missed = false;
          targets.jobs.forEach(function (job) {
            try { if (job(data || {}, cart) === false) missed = true; } catch (e) { missed = true; }
          });
          return missed;
        };

        /* 1. Sections that came back with the add / update request. */
        if (sections && targets.ids.every(function (id) { return !!sections[id]; })) {
          apply(sections);
          return Promise.resolve();
        }
        /* 2. Fallback: render them now (no cache); reload the page if that fails. */
        return fetchSections(targets.ids).then(function (data) {
          if (apply(data)) window.location.reload();
        }).catch(function () {
          window.location.reload();
        });
      }

      /* ---------------------------------------------------------------
       * 3. Component
       * ------------------------------------------------------------- */
      class ScFreeGift extends HTMLElement {
        connectedCallback() {
          if (this.__ready) return;
          var cfgEl = this.querySelector('[data-sc-fg-config]');
          var cartEl = this.querySelector('[data-sc-fg-cart]');
          try { this.cfg = JSON.parse(cfgEl.textContent); } catch (e) { return; }
          this.__ready = true;
          var initialCart = null;
          try { initialCart = JSON.parse(cartEl.textContent); } catch (e) {}

          var q = this.querySelector.bind(this);
          this.els = {
            message: q('[data-sc-fg-message]'),
            track: q('[data-sc-fg-track]'),
            fill: q('[data-sc-fg-fill]'),
            icon: q('[data-sc-fg-icon]'),
            notice: q('[data-sc-fg-notice]'),
            live: q('[data-sc-fg-live]'),
            /* One row per gift product (tier 1 choices + tier 2 choices). */
            rows: Array.prototype.slice.call(this.querySelectorAll('[data-sc-fg-gift]')),
            tier2Box: q('[data-sc-fg-tier-box="2"]'),
            gifts: q('[data-sc-fg-gifts]'),
            markers: Array.prototype.slice.call(this.querySelectorAll('[data-sc-fg-marker]'))
          };
          /* Older config (single gift) → one tier with one product. */
          if (!this.cfg.tiers || !this.cfg.tiers.length) {
            this.cfg.tiers = [{
              key: '1',
              threshold: this.cfg.threshold,
              autoAdd: this.cfg.autoAdd,
              products: this.cfg.giftVariantId ? [{ productId: this.cfg.giftProductId, variantId: this.cfg.giftVariantId, title: this.cfg.giftTitle, available: this.cfg.giftAvailable }] : []
            }];
          }
          if (!this.cfg.milestones || !this.cfg.milestones.length) this.cfg.milestones = [{ key: 't1', threshold: this.cfg.threshold }];

          var shop = window.Shopify || {};
          this.designMode = !!shop.designMode;
          this.rate = parseFloat(shop.currency && shop.currency.rate) || 1;
          this.locale = shop.locale || document.documentElement.lang || 'en';
          this.lastKey = 'sc-fg-last:' + this.cfg.giftVariantId;
          this.pending = false;

          /* Last known state, shared across re-renders and page loads. */
          var last = null;
          try { last = JSON.parse(sessionGet(this.lastKey) || 'null'); } catch (e) {}
          this.prev = last;

          this.renderCustomIcon();

          this.onCartChanged = this.scheduleRefresh.bind(this);
          this.onUpdated = this.handleUpdated.bind(this);
          this.onPageShow = function (e) { if (e.persisted) this.scheduleRefresh(); }.bind(this);
          this.onAddClick = function (e) {
            var btn = e.target.closest && e.target.closest('[data-sc-fg-add]');
            var row = btn && btn.closest('[data-sc-fg-gift]');
            if (row && this.contains(row)) this.handleManualAdd(row);
          }.bind(this);
          document.addEventListener('sc:cart:changed', this.onCartChanged);
          document.addEventListener('sc:cart:refresh', this.onCartChanged);
          document.addEventListener('sc:free-gift:updated', this.onUpdated);
          window.addEventListener('pageshow', this.onPageShow);
          this.addEventListener('click', this.onAddClick);

          /* A notice from the instance this one replaced (Dawn re-render). */
          if (G.notice && Date.now() - G.notice.at < 6000) this.showNotice(G.notice.kind, true);

          if (initialCart && initialCart.items) this.process(initialCart, {});
          else this.scheduleRefresh();
        }

        disconnectedCallback() {
          if (!this.__ready) return;
          this.__ready = false;
          document.removeEventListener('sc:cart:changed', this.onCartChanged);
          document.removeEventListener('sc:cart:refresh', this.onCartChanged);
          document.removeEventListener('sc:free-gift:updated', this.onUpdated);
          window.removeEventListener('pageshow', this.onPageShow);
          this.removeEventListener('click', this.onAddClick);
          clearTimeout(this.timer);
          clearTimeout(this.noticeTimer);
          clearTimeout(this.celebrateTimer);
        }

        renderCustomIcon() {
          var self = this;
          function swap(el, source) {
            if (!el || !source) return;
            var svg = sanitizeSvg(source);
            if (!svg) return;
            el.textContent = '';
            el.appendChild(svg);
          }
          swap(this.els.icon, this.cfg.customSvg);
          swap(this.querySelector('[data-sc-fg-marker="ship"]'), this.cfg.shipSvg);
          swap(this.querySelector('[data-sc-fg-marker="t2"]'), this.cfg.t2Svg);
          void self;
        }

        declinedKeyFor(tier) {
          return tier === '2' ? 'sc-fg-declined:t2' : 'sc-fg-declined:' + this.cfg.giftVariantId;
        }

        setAddsDisabled(disabled) {
          this.querySelectorAll('[data-sc-fg-add]').forEach(function (b) { b.disabled = disabled; });
        }

        /* ---- money ---- */
        formatMoney(cents) {
          cents = Math.max(0, Math.round(cents || 0));
          var cfg = this.cfg;
          var cur = this.currency || cfg.shopCurrency;
          if (cur === cfg.shopCurrency && cfg.moneyFormat) {
            var fmt = cfg.moneyFormat;
            if (cfg.moneyStyle === 'amount') {
              var m = fmt.match(/\{\{\s*\w+\s*\}\}/);
              fmt = m ? m[0] : '{' + '{amount}' + '}';
            }
            var out = formatWithShopifyFormat(cents, fmt);
            if (out) return out;
          }
          try {
            if (cfg.moneyStyle === 'amount') {
              return new Intl.NumberFormat(this.locale, { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(cents / 100);
            }
            var str = new Intl.NumberFormat(this.locale, { style: 'currency', currency: cur }).format(cents / 100);
            return cfg.moneyStyle === 'money_with_currency' && str.indexOf(cur) === -1 ? str + ' ' + cur : str;
          } catch (e) {
            return (cents / 100).toFixed(2) + ' ' + cur;
          }
        }

        /* Amount in the cart's (presentment) currency. */
        convert(t, cart) {
          t = t || 0;
          var converted = cart && cart.currency && cart.currency !== this.cfg.shopCurrency;
          if (!converted || this.rate === 1) return t;
          var value = t * this.rate;
          return this.cfg.roundConverted ? Math.ceil(value / 100) * 100 : Math.round(value);
        }

        /* Minimum of the first gift tier in the cart's currency. */
        thresholdFor(cart) {
          return this.convert(this.cfg.threshold, cart);
        }

        /* ---- state ---- */
        /* Which gift tier a cart line belongs to: '1', '2' or null (normal product). */
        tierOf(line) {
          var prop = line.properties && line.properties._sc_free_gift;
          if (prop) return String(prop) === '2' ? '2' : '1';
          if (this.cfg.pricingMode !== 'zero_price') return null;
          var tiers = this.cfg.tiers || [];
          for (var i = 0; i < tiers.length; i++) {
            var hit = tiers[i].products.some(function (p) { return p.productId === line.product_id; });
            if (hit) return tiers[i].key;
          }
          return null;
        }

        compute(cart) {
          var cfg = this.cfg;
          var self = this;
          var items = cart.items || [];
          var tiers = {};
          (cfg.tiers || []).forEach(function (t) {
            tiers[t.key] = { key: t.key, cfg: t, lines: [], qty: 0, linePrice: 0 };
          });
          var otherQty = 0, giftValue = 0;
          items.forEach(function (line) {
            var key = self.tierOf(line);
            if (!key) { otherQty += line.quantity; return; }
            giftValue += cfg.basis === 'original' ? (line.original_line_price || 0) : (line.final_line_price || 0);
            var tier = tiers[key];
            if (!tier) return;
            tier.lines.push(line);
            tier.qty += line.quantity;
            tier.linePrice += line.final_line_price || 0;
          });

          var base;
          if (cfg.basis === 'original') base = cart.original_total_price;
          else if (cfg.basis === 'total') base = cart.total_price;
          else base = cart.items_subtotal_price;
          var eligible = Math.max(0, (base || 0) - giftValue);

          Object.keys(tiers).forEach(function (k) {
            var t = tiers[k];
            t.threshold = self.convert(t.cfg.threshold, cart);
            t.unlocked = t.threshold > 0 && eligible > 0 && eligible >= t.threshold;
            t.inCart = t.lines.length > 0;
            t.available = t.cfg.products.some(function (p) { return p.available; });
          });

          var milestones = (cfg.milestones || []).map(function (m) {
            var th = self.convert(m.threshold, cart);
            return { key: m.key, threshold: th, reached: th > 0 && eligible > 0 && eligible >= th };
          });
          var max = milestones.reduce(function (a, m) { return Math.max(a, m.threshold); }, 0);
          var next = milestones.filter(function (m) { return !m.reached; })
            .sort(function (a, b) { return a.threshold - b.threshold; })[0] || null;

          var t1 = tiers['1'] || { lines: [], qty: 0, linePrice: 0, threshold: 0, unlocked: false, inCart: false };
          return {
            eligible: eligible,
            /* [threshold] / [amount] always refer to the next milestone. */
            threshold: next ? next.threshold : max,
            remaining: next ? Math.max(0, next.threshold - eligible) : 0,
            pct: max > 0 ? Math.min(100, (eligible / max) * 100) : 0,
            max: max,
            next: next,
            milestones: milestones,
            allReached: !next && max > 0 && eligible > 0,
            tiers: tiers,
            /* Tier 1 (the original single-gift fields). */
            unlocked: t1.unlocked,
            inCart: t1.inCart,
            giftLines: t1.lines,
            giftQty: t1.qty,
            giftLinePrice: t1.linePrice,
            otherQty: otherQty
          };
        }

        snapshot(s) {
          var tiers = {};
          Object.keys(s.tiers).forEach(function (k) { tiers[k] = { inCart: s.tiers[k].inCart, unlocked: s.tiers[k].unlocked }; });
          var reached = s.milestones.filter(function (m) { return m.reached; }).map(function (m) { return m.key; }).join(',');
          return { inCart: s.inCart, unlocked: s.unlocked, tiers: tiers, reached: reached };
        }

        process(cart, ctx) {
          ctx = ctx || {};
          this.cart = cart;
          this.currency = cart.currency || this.cfg.shopCurrency;
          var s = this.compute(cart);
          var prev = this.prev;
          var self = this;

          /* The customer removed a gift themselves while still eligible. */
          if (prev && !ctx.internal) {
            Object.keys(s.tiers).forEach(function (k) {
              var before = prev.tiers ? prev.tiers[k] : (k === '1' ? prev : null);
              var now = s.tiers[k];
              if (before && before.inCart && !now.inCart && now.unlocked) sessionSet(self.declinedKeyFor(k), '1');
            });
          }

          this.render(s, prev);
          this.prev = this.snapshot(s);
          sessionSet(this.lastKey, JSON.stringify(this.prev));
          this.classList.remove('is-pending');

          if (!ctx.noActions && this.decide(s)) this.run(false);
        }

        firstAvailable(tier) {
          var list = (tier.cfg && tier.cfg.products) || [];
          for (var i = 0; i < list.length; i++) if (list[i].available) return list[i];
          return null;
        }

        decide(s) {
          var cfg = this.cfg;
          var self = this;
          if (this.designMode) return null;
          var keys = Object.keys(s.tiers).sort();

          /* 1. Remove gifts of tiers the cart no longer qualifies for. */
          if (cfg.removeIneligible) {
            var removeUpdates = {};
            var removing = false;
            keys.forEach(function (k) {
              var t = s.tiers[k];
              if (!t.unlocked && t.inCart) {
                t.lines.forEach(function (l) { removeUpdates[l.key] = 0; });
                removing = true;
              }
            });
            if (removing) return { type: 'update', updates: removeUpdates, notice: 'removed' };
          }

          /* 2. One gift per tier, quantity 1. */
          var dedupe = {};
          var deduping = false;
          keys.forEach(function (k) {
            var t = s.tiers[k];
            if (t.unlocked && t.qty > 1) {
              t.lines.forEach(function (l, i) { dedupe[l.key] = i === 0 ? 1 : 0; });
              deduping = true;
            }
          });
          if (deduping) return { type: 'update', updates: dedupe };

          /* 3. Auto add, tier by tier (tier 2 only once a tier-1 gift is in the cart). */
          for (var i = 0; i < keys.length; i++) {
            var k = keys[i];
            var t = s.tiers[k];
            if (k === '2' && s.tiers['1'] && !s.tiers['1'].inCart) continue;
            var product = self.firstAvailable(t);
            if (
              t.unlocked && !t.inCart && t.cfg.autoAdd && product && !G.addFailed[k] &&
              !(cfg.readdMode === 'respect' && sessionGet(self.declinedKeyFor(k)))
            ) {
              return { type: 'add', tier: k, variantId: product.variantId, notice: 'added' };
            }
          }
          return null;
        }

        handleManualAdd(row) {
          var tier = row.getAttribute('data-tier') || '1';
          var variantId = Number(row.getAttribute('data-variant-id'));
          var t = this.state && this.state.tiers[tier];
          if (G.busy || !t || !t.unlocked || t.inCart || !variantId) return;
          sessionDel(this.declinedKeyFor(tier));
          G.addFailed[tier] = false;
          this.run(true, { tier: tier, variantId: variantId });
        }

        scheduleRefresh() {
          if (!this.__ready) return;
          if (G.busy) { this.pending = true; return; }
          clearTimeout(this.timer);
          var self = this;
          this.timer = setTimeout(function () {
            request('cart.js').then(function (cart) { if (self.__ready) self.process(cart, {}); }).catch(function () {});
          }, 200);
        }

        /* Another instance (or this one) changed the gift: redraw from its cart. */
        handleUpdated(e) {
          var cart = e.detail && e.detail.cart;
          if (!cart || !this.__ready) return;
          var again = this.pending;
          this.pending = false;
          this.process(cart, { internal: true, noActions: !again });
        }

        /* Every action re-reads the cart first and decides again, under one
           global lock, so two instances can never add a gift twice. */
        run(manual, target) {
          if (G.busy) { this.pending = true; return; }
          if (!manual && G.actions.length >= 3) {
            if (window.console) console.warn('[SC free gift] Stopped: too many automatic cart changes in a short time.');
            return;
          }

          var self = this;
          var cfg = this.cfg;
          var action = null;
          var sections = null;
          G.busy = true;
          this.setAttribute('aria-busy', 'true');
          this.setAddsDisabled(true);

          request('cart.js').then(function (cart) {
            var s = self.compute(cart);
            if (manual) {
              var t = target && s.tiers[target.tier];
              action = t && t.unlocked && !t.inCart ? { type: 'add', tier: target.tier, variantId: target.variantId, notice: 'added' } : null;
            } else {
              action = self.decide(s);
            }
            if (!action) return cart;
            if (!manual) G.actions.push(Date.now());
            if (action.type === 'add') {
              return request('cart/add.js', Object.assign({
                items: [{ id: action.variantId, quantity: 1, properties: { _sc_free_gift: action.tier === '2' ? '2' : 'true' } }]
              }, sectionParams())).then(function (res) {
                sections = res && res.sections;
                return request('cart.js');
              });
            }
            return request('cart/update.js', Object.assign({ updates: action.updates }, sectionParams())).then(function (cart) {
              sections = cart && cart.sections;
              return cart;
            });
          }).then(function (cart) {
            G.busy = false;
            if (!action) {
              if (self.__ready) self.process(cart, { internal: true, noActions: true });
              return;
            }
            if (action.notice) G.notice = { kind: action.notice, at: Date.now() };
            if (self.__ready && action.notice) self.showNotice(action.notice);
            if (action.type === 'add') {
              var added = self.compute(cart).tiers[action.tier];
              if (added && added.inCart && added.linePrice > 0 && window.console) {
                console.warn('[SC free gift] The gift line is not free in the cart (' + self.formatMoney(added.linePrice) + '). Check the gift product price or the automatic discount.');
              }
            }
            /* Also tells every other instance (handleUpdated). */
            return refreshThemeCart(cart, cfg.refresh, sections);
          }).catch(function (err) {
            G.busy = false;
            if (action && action.type === 'add') G.addFailed[action.tier] = true;
            if (self.__ready) self.showNotice('error');
            if (window.console) console.warn('[SC free gift]', err && err.message);
          }).then(function () {
            if (!self.__ready) return;
            self.removeAttribute('aria-busy');
            self.setAddsDisabled(false);
            if (self.pending) { self.pending = false; self.scheduleRefresh(); }
          });
        }

        /* ---- UI ---- */
        buildMessage(template, s, giftTitle) {
          var frag = document.createDocumentFragment();
          var self = this;
          var title = giftTitle != null ? giftTitle : (self.cfg.giftTitle || '');
          String(template || '').split(/(\[amount\]|\[threshold\]|\[gift\])/).forEach(function (part) {
            if (!part) return;
            if (part === '[gift]') {
              frag.appendChild(document.createTextNode(title));
            } else if (part === '[amount]' || part === '[threshold]') {
              var strong = document.createElement('strong');
              strong.className = 'sc-fg__amount';
              strong.textContent = self.formatMoney(part === '[amount]' ? s.remaining : s.threshold);
              frag.appendChild(strong);
            } else {
              frag.appendChild(document.createTextNode(part));
            }
          });
          return frag;
        }

        /* Message for the next milestone, or the final one when everything is reached. */
        messageFor(s) {
          var msgs = this.cfg.messages;
          var t1 = s.tiers['1'];
          var t2 = s.tiers['2'];
          var t2Title = t2 && t2.cfg.products[0] ? t2.cfg.products[0].title : '';
          if (s.next) {
            if (s.next.key === 'ship') return { template: msgs.shipLocked };
            if (s.next.key === 't2') return { template: msgs.t2Locked, gift: t2Title };
            return { template: msgs.locked };
          }
          var ship = s.milestones.filter(function (m) { return m.key === 'ship'; })[0];
          if (t2 && t2.threshold === s.max) return { template: msgs.t2Unlocked, gift: t2Title };
          if (ship && ship.threshold === s.max && t1 && ship.threshold > t1.threshold) return { template: msgs.shipUnlocked };
          return { template: t1 && t1.available ? msgs.unlocked : msgs.soldOut };
        }

        render(s, prev) {
          var cfg = this.cfg;
          var els = this.els;
          var self = this;
          this.state = s;

          this.hidden = !!((cfg.hideEmpty || cfg.inBar) && s.otherQty === 0);
          this.classList.toggle('is-unlocked', s.allReached);

          var msg = this.messageFor(s);
          if (els.message) {
            els.message.textContent = '';
            els.message.appendChild(this.buildMessage(msg.template, s, msg.gift));
          }
          if (els.fill) els.fill.style.width = s.pct.toFixed(2) + '%';
          if (els.track) {
            els.track.setAttribute('aria-valuenow', String(Math.floor(s.pct)));
            els.track.setAttribute('aria-valuetext', this.buildMessage(msg.template, s, msg.gift).textContent);
          }

          /* Milestone markers (multi-milestone bar only). */
          els.markers.forEach(function (marker) {
            var m = s.milestones.filter(function (x) { return x.key === marker.getAttribute('data-sc-fg-marker'); })[0];
            if (!m) return;
            marker.classList.toggle('is-reached', m.reached);
            if (s.max > 0) marker.style.left = ((m.threshold / s.max) * 100).toFixed(3) + '%';
          });

          /* Tier 2 is offered once a tier-1 gift is in the cart. */

          els.rows.forEach(function (row) {
            var t = s.tiers[row.getAttribute('data-tier')];
            if (!t) { row.hidden = true; return; }
            var productId = Number(row.getAttribute('data-product-id'));
            var available = row.getAttribute('data-available') === 'true';
            var line = t.lines.filter(function (l) { return l.product_id === productId; })[0];

            /* Only offered while it can be added: hidden once this tier's gift is in the cart
               (the cart list shows it) and when sold out; locked rows follow the setting. */
            row.hidden = t.inCart || (!t.unlocked && !cfg.showGiftLocked) || (t.unlocked && !available);
            row.classList.toggle('is-locked', !t.unlocked);

            var add = row.querySelector('[data-sc-fg-add]');
            var added = row.querySelector('[data-sc-fg-added]');
            var locked = row.querySelector('[data-sc-fg-locked]');
            if (add) add.hidden = !(t.unlocked && !t.inCart && available);
            if (added) added.hidden = !(t.unlocked && line);
            if (locked) locked.hidden = t.unlocked;

            /* Never claim "Free" if the gift line in the cart actually costs money. */
            var paid = !!(line && line.final_line_price > 0);
            var free = row.querySelector('[data-sc-fg-free]');
            var strike = row.querySelector('[data-sc-fg-strike]');
            var linePrice = row.querySelector('[data-sc-fg-line-price]');
            if (free) free.hidden = paid;
            if (strike) strike.hidden = paid;
            if (linePrice) {
              linePrice.hidden = !paid;
              linePrice.textContent = paid ? self.formatMoney(line.final_line_price) : '';
            }
          });

          /* Hide the second-gift heading / the whole list when no row is left to show. */
          var visible = function (box) {
            return !!box && Array.prototype.some.call(box.querySelectorAll('[data-sc-fg-gift]'), function (r) { return !r.hidden; });
          };
          if (els.tier2Box) els.tier2Box.hidden = !(s.tiers['1'] && s.tiers['1'].inCart) || !visible(els.tier2Box);
          if (els.gifts) els.gifts.hidden = !visible(els.gifts);

          if (s.unlocked && els.notice && els.notice.dataset.kind === 'removed') els.notice.hidden = true;

          /* Announce milestone changes only (not every amount change). */
          var reached = s.milestones.filter(function (m) { return m.reached; }).map(function (m) { return m.key; }).join(',');
          var before = prev ? (prev.reached != null ? prev.reached : (prev.unlocked ? 't1' : '')) : null;
          if (before !== null && reached !== before) {
            if (reached.length > before.length) this.celebrate();
            if (els.live) {
              var text = this.buildMessage(msg.template, s, msg.gift).textContent;
              var live = els.live;
              live.textContent = '';
              setTimeout(function () { live.textContent = text; }, 50);
            }
          }
        }

        celebrate() {
          var self = this;
          this.classList.remove('is-celebrating');
          void this.offsetWidth;
          this.classList.add('is-celebrating');
          clearTimeout(this.celebrateTimer);
          this.celebrateTimer = setTimeout(function () { self.classList.remove('is-celebrating'); }, 700);
        }

        showNotice(kind, fromPrevious) {
          var el = this.els.notice;
          var template = this.cfg.messages[kind];
          if (!el || !template) return;
          var s = this.state || { remaining: 0, threshold: this.thresholdFor(this.cart) };
          if (!this.state) this.currency = this.currency || this.cfg.shopCurrency;
          el.textContent = '';
          el.appendChild(this.buildMessage(template, s));
          el.classList.toggle('sc-fg__notice--error', kind === 'error');
          el.dataset.kind = kind;
          el.hidden = false;
          clearTimeout(this.noticeTimer);
          if (kind !== 'removed') {
            var self = this;
            this.noticeTimer = setTimeout(function () {
              el.hidden = true;
              if (G.notice && G.notice.kind === kind) G.notice = null;
            }, fromPrevious ? 4000 : 6000);
          }
        }
      }

      customElements.define('sc-free-gift', ScFreeGift);
    })();
  </script>
{%- elsif request.design_mode and settings.sc_fg_enable and sc_place_on -%}
  <div style="margin:12px 0;padding:12px 14px;border:1px dashed #c9a227;border-radius:8px;background:#fffbea;color:#5c4a00;font-size:13px;line-height:1.5;font-family:inherit;text-align:start;">
    <strong>SC – Free gift</strong> (only visible in the theme editor)<br>
    {%- if sc_has_threshold == false -%}
      Theme settings → SC – Free gift: enter a "Free gift minimum amount" greater than 0.
    {%- elsif sc_gift == blank -%}
      Theme settings → SC – Free gift: select a gift product to show the free gift bar.
    {%- elsif sc_price_issue -%}
      "{{ sc_gift.title | escape }}" costs {{ sc_gift_variant.price | money }}. With "Gift pricing: Gift product priced 0.00" the product must cost 0.00, or switch to "Automatic discount" after creating that discount. The bar stays hidden so customers are never charged for a "free" gift.
    {%- elsif sc_gift_available == false -%}
      "{{ sc_gift.title | escape }}" is sold out, so the bar is hidden. Turn off "Hide when the gift is sold out" to keep showing it.
    {%- endif -%}
  </div>
{%- endif -%}
