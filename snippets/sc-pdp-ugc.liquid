{%- comment -%}
  SC | PDP UGC Customer Photo Carousel
  Reads product metafield custom.sc_pdp_ugc (reference to metaobject sc_pdp_ugc).
  Metaobject fields: button_title, feedback_title and, for n = 01..05:
    feedback_thumbnail_0n (image), feedback_avatar_0n (image), feedback_ratings_0n (decimal 1-5),
    feedback_name_0n, feedback_label_0n (single line text)
  Self-contained: CSS scroll-snap carousel + small scoped JS (no Flickity needed).
  Accepts: product, block
{%- endcomment -%}

{%- assign sc_ugc = product.metafields.custom.sc_pdp_ugc.value -%}

{%- if sc_ugc != blank -%}
  {%- assign sc_id = block.id -%}
  {%- assign sc_ratio = '1 / 1' -%}
  {%- if block.settings.sc_ugc_ratio == 'classic' -%}
    {%- assign sc_ratio = '3 / 2' -%}
  {%- elsif block.settings.sc_ugc_ratio == 'widescreen' -%}
    {%- assign sc_ratio = '16 / 9' -%}
  {%- endif -%}
  {%- assign sc_collapsible = false -%}
  {%- if block.settings.sc_ugc_layout == 'collapsible' -%}
    {%- assign sc_collapsible = true -%}
  {%- endif -%}

  {%- capture sc_ugc_content -%}
    {%- if sc_ugc.feedback_title.value != blank -%}
      <p class="sc_ugc__heading">{{ sc_ugc.feedback_title.value | escape }}</p>
    {%- endif -%}
    <div
      class="sc_ugc__carousel"
      data-sc-ugc-carousel
      data-autoplay="{{ block.settings.sc_ugc_autoplay }}"
      data-loop="{{ block.settings.sc_ugc_loop }}"
    >
      <ul class="sc_ugc__track" tabindex="0" aria-label="{{ sc_ugc.feedback_title.value | default: sc_ugc.button_title.value | escape }}">
        {%- for i in (1..5) -%}
          {%- assign sc_k = 'feedback_thumbnail_0' | append: i -%}
          {%- assign sc_thumb = sc_ugc[sc_k].value -%}
          {%- if sc_thumb != blank -%}
            {%- assign sc_k = 'feedback_avatar_0' | append: i -%}
            {%- assign sc_avatar = sc_ugc[sc_k].value -%}
            {%- assign sc_k = 'feedback_ratings_0' | append: i -%}
            {%- assign sc_rating = sc_ugc[sc_k].value | default: 0 | times: 1.0 | at_least: 0 | at_most: 5 -%}
            {%- assign sc_k = 'feedback_name_0' | append: i -%}
            {%- assign sc_name = sc_ugc[sc_k].value -%}
            {%- assign sc_k = 'feedback_label_0' | append: i -%}
            {%- assign sc_label = sc_ugc[sc_k].value -%}
            <li class="sc_ugc__item">
              <div class="sc_ugc__card">
                <div class="sc_ugc__thumb">
                  {{- sc_thumb | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 400px, 80vw', widths: '400, 600, 800', alt: sc_thumb.alt | default: sc_name -}}
                </div>
                <div class="sc_ugc__info">
                  <span class="sc_ugc__avatar">
                    {%- if sc_avatar != blank -%}
                      {{- sc_avatar | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60, 120', alt: '' -}}
                    {%- else -%}
                      {{- 'image' | placeholder_svg_tag -}}
                    {%- endif -%}
                  </span>
                  <span class="sc_ugc__author">
                    {%- if sc_rating > 0 -%}
                      {%- assign sc_pct = sc_rating | times: 20 -%}
                      <span class="sc_ugc__stars" role="img" aria-label="{{ sc_rating }} / 5">
                        <span class="sc_ugc__stars-fill" style="width: {{ sc_pct }}%" aria-hidden="true">★★★★★</span>
                        <span aria-hidden="true">★★★★★</span>
                      </span>
                    {%- endif -%}
                    {%- if sc_name != blank -%}<strong class="sc_ugc__name">{{ sc_name | escape }}</strong>{%- endif -%}
                    {%- if sc_label != blank -%}<span class="sc_ugc__label">{{ sc_label | escape }}</span>{%- endif -%}
                  </span>
                </div>
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if block.settings.sc_ugc_dots -%}
        <div class="sc_ugc__dots" data-sc-ugc-dots></div>
      {%- endif -%}
    </div>
  {%- endcapture -%}

  <div id="sc_ugc-{{ sc_id }}" class="sc_ugc" {{ block.shopify_attributes }}>
    {%- if sc_collapsible -%}
      <details class="sc_ugc__details"{% if block.settings.sc_ugc_open_default %} open{% endif %}>
        <summary class="sc_ugc__summary">
          <span class="sc_ugc__summary-title">{{ sc_ugc.button_title.value | default: sc_ugc.feedback_title.value | escape }}</span>
          <span class="sc_ugc__arrow" aria-hidden="true">
            <svg width="8" height="7" viewBox="0 0 8 7" fill="none"><path d="M7 5.3L4 2.3 1 5.3" stroke="currentColor" stroke-width="1.5"/></svg>
          </span>
        </summary>
        <div class="sc_ugc__body">{{ sc_ugc_content }}</div>
      </details>
    {%- else -%}
      {{ sc_ugc_content }}
    {%- endif -%}
  </div>

  <style>
    #sc_ugc-{{ sc_id }} {
      margin-top: {{ block.settings.sc_ugc_space_top }}px;
      margin-bottom: {{ block.settings.sc_ugc_space_bottom }}px;
      overflow: hidden;
    }
    #sc_ugc-{{ sc_id }} .sc_ugc__summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 12px 0;
      cursor: pointer;
      list-style: none;
      user-select: none;
      {% if block.settings.sc_ugc_show_border %}border-bottom: 1px solid {{ block.settings.sc_ugc_border_color }};{% endif %}
    }
    #sc_ugc-{{ sc_id }} .sc_ugc__summary::-webkit-details-marker { display: none; }
    #sc_ugc-{{ sc_id }} .sc_ugc__summary-title { font-size: {{ block.settings.sc_ugc_button_size }}px; font-weight: 600; line-height: 1.5; }
    #sc_ugc-{{ sc_id }} .sc_ugc__arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: {{ block.settings.sc_ugc_arrow_bg }};
      color: {{ block.settings.sc_ugc_arrow_color }};
      transition: transform 0.2s ease;
    }
    #sc_ugc-{{ sc_id }} .sc_ugc__details:not([open]) .sc_ugc__arrow { transform: rotate(180deg); }
    #sc_ugc-{{ sc_id }} .sc_ugc__details[open] .sc_ugc__body { padding-top: 20px; }
    #sc_ugc-{{ sc_id }} .sc_ugc__heading {
      margin: 0 0 12px;
      font-weight: 600;
      line-height: 1.2;
      text-align: {{ block.settings.sc_ugc_heading_align }};
      font-size: {{ block.settings.sc_ugc_heading_size_mobile }}px;
    }
    #sc_ugc-{{ sc_id }} .sc_ugc__track {
      display: flex;
      gap: {{ block.settings.sc_ugc_gap }}px;
      margin: 0;
      padding: 0;
      list-style: none;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    #sc_ugc-{{ sc_id }} .sc_ugc__track::-webkit-scrollbar { display: none; }
    #sc_ugc-{{ sc_id }} .sc_ugc__item {
      flex: 0 0 {{ block.settings.sc_ugc_visible }}%;
      scroll-snap-align: {{ block.settings.sc_ugc_cell_align }};
      min-width: 0;
    }
    #sc_ugc-{{ sc_id }} .sc_ugc__card {
      position: relative;
      overflow: hidden;
      border-radius: {{ block.settings.sc_ugc_radius }}px;
    }
    #sc_ugc-{{ sc_id }} .sc_ugc__card::after {
      content: '';
      position: absolute;
      inset: 0;
      background: {{ block.settings.sc_ugc_shadow | default: 'linear-gradient(180deg, rgba(0,0,0,0) 71%, rgba(0,0,0,0.7) 100%)' }};
      pointer-events: none;
    }
    #sc_ugc-{{ sc_id }} .sc_ugc__thumb { aspect-ratio: {{ sc_ratio }}; }
    #sc_ugc-{{ sc_id }} .sc_ugc__thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }
    #sc_ugc-{{ sc_id }} .sc_ugc__info {
      position: absolute;
      left: 16px;
      bottom: 16px;
      z-index: 1;
      display: flex;
      align-items: center;
      gap: 12px;
      color: {{ block.settings.sc_ugc_text_color }};
    }
    #sc_ugc-{{ sc_id }} .sc_ugc__avatar {
      flex: none;
      width: {{ block.settings.sc_ugc_avatar_size }}px;
      height: {{ block.settings.sc_ugc_avatar_size }}px;
      border-radius: 50%;
      overflow: hidden;
      background: #efefef;
    }
    #sc_ugc-{{ sc_id }} .sc_ugc__avatar img,
    #sc_ugc-{{ sc_id }} .sc_ugc__avatar svg { display: block; width: 100%; height: 100%; object-fit: cover; }
    #sc_ugc-{{ sc_id }} .sc_ugc__author { display: flex; flex-direction: column; gap: 4px; line-height: 1; }
    #sc_ugc-{{ sc_id }} .sc_ugc__name { font-size: {{ block.settings.sc_ugc_name_size }}px; font-weight: 600; }
    #sc_ugc-{{ sc_id }} .sc_ugc__label { font-size: {{ block.settings.sc_ugc_label_size }}px; }
    #sc_ugc-{{ sc_id }} .sc_ugc__stars {
      position: relative;
      display: inline-block;
      font-size: 14px;
      letter-spacing: 2px;
      line-height: 1;
      color: {{ block.settings.sc_ugc_rating_color }};
    }
    #sc_ugc-{{ sc_id }} .sc_ugc__stars > span:not(.sc_ugc__stars-fill) { opacity: 0.4; }
    #sc_ugc-{{ sc_id }} .sc_ugc__stars-fill { position: absolute; inset: 0 auto 0 0; overflow: hidden; white-space: nowrap; z-index: 1; }
    #sc_ugc-{{ sc_id }} .sc_ugc__dots { display: flex; justify-content: center; gap: 8px; margin-top: 12px; }
    #sc_ugc-{{ sc_id }} .sc_ugc__dot {
      width: 6px;
      height: 6px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: {{ block.settings.sc_ugc_dots_color }};
      opacity: 0.3;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }
    #sc_ugc-{{ sc_id }} .sc_ugc__dot[aria-current='true'] { opacity: 1; }
    @media (min-width: 750px) {
      #sc_ugc-{{ sc_id }} .sc_ugc__heading { font-size: {{ block.settings.sc_ugc_heading_size }}px; }
    }
  </style>

  <script>
    (function () {
      var root = document.getElementById('sc_ugc-{{ sc_id }}');
      if (!root) return;
      var carousel = root.querySelector('[data-sc-ugc-carousel]');
      if (!carousel) return;
      var track = carousel.querySelector('.sc_ugc__track');
      var items = track.children;
      var dotsWrap = carousel.querySelector('[data-sc-ugc-dots]');
      var dots = [];
      var timer;

      function step() {
        return items.length > 1 ? items[1].offsetLeft - items[0].offsetLeft : track.clientWidth;
      }
      function current() {
        return Math.min(items.length - 1, Math.max(0, Math.round(track.scrollLeft / (step() || 1))));
      }
      function goTo(i) {
        track.scrollTo({ left: i * step(), behavior: 'smooth' });
      }
      function mark() {
        var c = current();
        dots.forEach(function (d, i) {
          if (i === c) d.setAttribute('aria-current', 'true');
          else d.removeAttribute('aria-current');
        });
      }

      if (dotsWrap) {
        for (var i = 0; i < items.length; i++) {
          var b = document.createElement('button');
          b.type = 'button';
          b.className = 'sc_ugc__dot';
          b.setAttribute('aria-label', (i + 1) + ' / ' + items.length);
          b.addEventListener('click', goTo.bind(null, i));
          dotsWrap.appendChild(b);
          dots.push(b);
        }
        mark();
      }
      var raf;
      track.addEventListener('scroll', function () {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(mark);
      }, { passive: true });

      if (carousel.dataset.autoplay === 'true' && items.length > 1 &&
          !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        var loop = carousel.dataset.loop === 'true';
        var stop = function () { clearInterval(timer); };
        var start = function () {
          stop();
          timer = setInterval(function () {
            if (!document.body.contains(root)) return stop();
            var atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
            if (atEnd) { if (loop) goTo(0); else stop(); }
            else goTo(current() + 1);
          }, 4000);
        };
        carousel.addEventListener('mouseenter', stop);
        carousel.addEventListener('mouseleave', start);
        carousel.addEventListener('focusin', stop);
        carousel.addEventListener('focusout', start);
        start();
      }
    })();
  </script>
{%- endif -%}
